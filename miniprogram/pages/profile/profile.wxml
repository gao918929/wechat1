<px-nav title="我的" subtitle="角色档案" large />
<view class="container" wx:if="{{meta}}">
  <!-- character card: mascot portrait + name + goal, daily targets as an RPG stat panel -->
  <view class="card hero char-card anim-slide">
    <view class="win-tab"><image class="win-tab-icon" src="/assets/px/tab-me.svg" />角色卡</view>
    <view class="char-top">
      <view class="portrait">
        <view class="portrait-ground"></view>
        <view class="portrait-sprite"><px-sprite name="sprite-chef" frames="4" size="144" duration="1200" /></view>
      </view>
      <view class="char-info">
        <view class="char-lbl">玩家</view>
        <view class="char-name ellipsis">{{form.nickname || '未命名'}}</view>
        <view class="char-goal"><image class="goal-icon" src="/assets/px/star.svg" /><text class="grow">{{goalText}}</text></view>
      </view>
    </view>

    <view class="px-dialog attr-panel" wx:if="{{targets}}">
      <view class="attr-head">
        <text>每日目标</text>
        <text class="attr-hint">属性</text>
      </view>
      <view class="attr-grid">
        <view class="attr">
          <image class="attr-icon" src="/assets/px/flame.svg" />
          <view class="attr-body"><view class="attr-k">能量</view><view class="attr-v"><text class="px-num attr-num">{{targets.daily.kcal}}</text><text class="attr-u">kcal</text></view></view>
        </view>
        <view class="attr">
          <image class="attr-icon" src="/assets/px/egg.svg" />
          <view class="attr-body"><view class="attr-k">蛋白质</view><view class="attr-v"><text class="px-num attr-num">{{targets.daily.protein_g}}</text><text class="attr-u">g</text></view></view>
        </view>
        <view class="attr">
          <image class="attr-icon" src="/assets/px/oil.svg" />
          <view class="attr-body"><view class="attr-k">脂肪</view><view class="attr-v"><text class="px-num attr-num">{{targets.daily.fat_g}}</text><text class="attr-u">g</text></view></view>
        </view>
        <view class="attr">
          <image class="attr-icon" src="/assets/px/meal.svg" />
          <view class="attr-body"><view class="attr-k">碳水</view><view class="attr-v"><text class="px-num attr-num">{{targets.daily.carb_g}}</text><text class="attr-u">g</text></view></view>
        </view>
      </view>
    </view>
    <view class="basis" wx:if="{{targets}}"><image class="basis-icon" src="/assets/px/scale.svg" /><text class="grow">{{targets.daily.basis}}</text></view>
    <view class="note" wx:for="{{targets.daily.notes}}" wx:key="*this"><image class="note-icon" src="/assets/px/warn.svg" /><text class="grow">{{item}}</text></view>
  </view>

  <!-- menu -->
  <view class="card flush menu-card anim-slide d1">
    <view class="menu" hover-class="px-pressed-row" bindtap="go" data-url="/pages/twin/twin">
      <view class="mini-icon i-purple"><image src="/assets/px/twin.svg" /></view>
      <text class="menu-name">数字孪生</text>
      <text class="menu-sub">越用越懂你</text>
      <image class="chev" src="/assets/px/ui-next.svg" />
    </view>
    <view class="menu" hover-class="px-pressed-row" bindtap="go" data-url="/pages/group/group">
      <view class="mini-icon i-blue"><image src="/assets/px/users.svg" /></view>
      <text class="menu-name">小组管理</text>
      <text class="menu-sub">宿舍 / 家庭</text>
      <image class="chev" src="/assets/px/ui-next.svg" />
    </view>
    <view class="menu" hover-class="px-pressed-row" bindtap="go" data-url="/pages/nutrition/nutrition">
      <view class="mini-icon i-teal"><image src="/assets/px/chart.svg" /></view>
      <text class="menu-name">营养分析</text>
      <text class="menu-sub">评级与趋势</text>
      <image class="chev" src="/assets/px/ui-next.svg" />
    </view>
    <view class="menu" hover-class="px-pressed-row" bindtap="go" data-url="/pages/notifications/notifications">
      <view class="mini-icon i-pink"><image src="/assets/px/bell.svg" /></view>
      <text class="menu-name">消息通知</text>
      <image class="chev" src="/assets/px/ui-next.svg" />
    </view>
  </view>

  <!-- health profile form -->
  <view class="section-title"><text>健康资料</text></view>
  <view class="card flush form-card anim-slide d2">
    <view class="field"><text class="label">昵称</text><input class="input" value="{{form.nickname}}" data-k="nickname" bindinput="onField" /></view>
    <picker range="{{sexes}}" range-key="label" value="{{sexIndex}}" bindchange="onSex">
      <view class="field pick" hover-class="px-pressed-row"><text class="label">性别</text><text class="pick-v">{{sexes[sexIndex].label}}</text><image class="pick-caret" src="/assets/px/ui-next.svg" /></view>
    </picker>
    <view class="field"><text class="label">年龄</text><input class="input" type="number" value="{{form.age}}" data-k="age" bindinput="onField" /></view>
    <view class="field"><text class="label">身高 cm</text><input class="input" type="digit" value="{{form.height_cm}}" data-k="height_cm" bindinput="onField" /></view>
    <view class="field"><text class="label">体重 kg</text><input class="input" type="digit" value="{{form.weight_kg}}" data-k="weight_kg" bindinput="onField" /></view>
    <view class="field"><text class="label">体脂率 %</text><input class="input" type="digit" value="{{form.body_fat_pct}}" data-k="body_fat_pct" bindinput="onField" placeholder="可选" /></view>
    <picker range="{{meta.activity_levels}}" range-key="label" value="{{activityIndex}}" bindchange="onActivity">
      <view class="field pick" hover-class="px-pressed-row"><text class="label">活动水平</text><text class="pick-v">{{meta.activity_levels[activityIndex].label}}</text><image class="pick-caret" src="/assets/px/ui-next.svg" /></view>
    </picker>
    <view class="field opts-field">
      <text class="label">目标</text>
      <view class="opts"><text wx:for="{{meta.goals}}" wx:key="key" class="opt {{form.goal === item.key ? 'on gold' : ''}}" hover-class="px-pressed" bindtap="setGoal" data-k="{{item.key}}">{{item.label}}</text></view>
    </view>
    <view class="field opts-field">
      <text class="label">人群模型</text>
      <view class="opts"><text wx:for="{{meta.dietary_groups}}" wx:key="key" class="opt {{sel.groups[item.key] ? (item.special_need ? 'on warn' : 'on') : ''}}" hover-class="px-pressed" bindtap="toggleSel" data-group="groups" data-k="{{item.key}}">{{item.label}}</text></view>
    </view>
  </view>

  <!-- allergens & avoidances -->
  <view class="section-title"><text>忌口与过敏</text></view>
  <view class="card diet-card anim-slide d3">
    <view class="sub-title">
      <image class="st-icon" src="/assets/px/shield.svg" />
      <text class="st-name">过敏原</text>
      <text class="tag danger">硬约束 · 一票否决</text>
    </view>
    <view class="opts">
      <text wx:for="{{meta.allergen_options}}" wx:key="key" class="opt {{sel.allergens[item.key] ? 'on danger' : ''}}" hover-class="px-pressed" bindtap="toggleSel" data-group="allergens" data-k="{{item.key}}">{{item.label}}</text>
      <view wx:for="{{extraAllergens}}" wx:key="*this" class="opt on danger extra" hover-class="px-pressed" bindtap="removeExtra" data-list="extraAllergens" data-v="{{item}}"><text>{{item}}</text><image class="opt-x" src="/assets/px/cross.svg" /></view>
    </view>
    <view class="chat-bar add-bar">
      <input class="input" placeholder="其他过敏食材" value="{{customAllergen}}" data-k="customAllergen" bindinput="onCustom" />
      <button class="btn ghost small add-btn" hover-class="px-pressed" bindtap="addCustom" data-k="allergen"><image class="btn-icon" src="/assets/px/plus.svg" />添加</button>
    </view>

    <view class="sub-title gap">
      <image class="st-icon" src="/assets/px/chili.svg" />
      <text class="st-name">口味忌口</text>
      <text class="tag warn">软约束 · 可推翻</text>
    </view>
    <view class="opts">
      <text wx:for="{{meta.avoid_options}}" wx:key="key" class="opt {{sel.avoidances[item.key] ? 'on warn' : ''}}" hover-class="px-pressed" bindtap="toggleSel" data-group="avoidances" data-k="{{item.key}}">{{item.label}}</text>
      <view wx:for="{{extraAvoid}}" wx:key="*this" class="opt on warn extra" hover-class="px-pressed" bindtap="removeExtra" data-list="extraAvoid" data-v="{{item}}"><text>{{item}}</text><image class="opt-x" src="/assets/px/cross.svg" /></view>
    </view>
    <view class="chat-bar add-bar">
      <input class="input" placeholder="其他不吃的食材，如 洋葱" value="{{customAvoid}}" data-k="customAvoid" bindinput="onCustom" />
      <button class="btn ghost small add-btn" hover-class="px-pressed" bindtap="addCustom" data-k="avoid"><image class="btn-icon" src="/assets/px/plus.svg" />添加</button>
    </view>

    <view class="spicy">
      <view class="spicy-head">
        <text class="spicy-lbl">最高辣度</text>
        <view class="chilis"><image wx:for="{{spicyLevels}}" wx:key="*this" class="chili {{form.max_spicy >= item ? 'on' : ''}}" src="/assets/px/chili.svg" /></view>
        <text class="spicy-name">{{spicyNames[form.max_spicy]}}</text>
      </view>
      <slider class="spicy-slider" min="0" max="3" step="1" value="{{form.max_spicy}}" bindchange="onSpicy" activeColor="#e8553e" backgroundColor="#e2d3b1" block-color="#fffaf0" block-size="20" />
    </view>
    <view class="likes">
      <view class="likes-head"><image class="st-icon" src="/assets/px/heart.svg" /><text class="st-name">爱吃</text></view>
      <input class="input" value="{{likesText}}" bindinput="onLikes" placeholder="用顿号分隔，如 牛肉、西兰花" />
    </view>
    <button class="btn save-btn" hover-class="px-pressed" bindtap="save">保存资料</button>
  </view>
  <view class="notice">{{meta.disclaimer}}</view>
</view>
