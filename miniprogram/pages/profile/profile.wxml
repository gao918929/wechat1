<view class="container" wx:if="{{meta}}">
  <view class="card">
    <view class="row wrap">
      <view class="grid-item" bindtap="go" data-url="/pages/twin/twin"><view class="icon">🧬</view><view class="small">数字孪生</view></view>
      <view class="grid-item" bindtap="go" data-url="/pages/group/group"><view class="icon">👥</view><view class="small">小组管理</view></view>
      <view class="grid-item" bindtap="go" data-url="/pages/nutrition/nutrition"><view class="icon">📊</view><view class="small">营养分析</view></view>
    </view>
  </view>

  <view class="card" wx:if="{{targets}}">
    <view class="card-title">我的每日目标</view>
    <view class="row">
      <view class="stat"><view class="num">{{targets.daily.kcal}}</view><view class="lbl">kcal</view></view>
      <view class="stat"><view class="num">{{targets.daily.protein_g}}</view><view class="lbl">蛋白质 g</view></view>
      <view class="stat"><view class="num">{{targets.daily.fat_g}}</view><view class="lbl">脂肪 g</view></view>
      <view class="stat"><view class="num">{{targets.daily.carb_g}}</view><view class="lbl">碳水 g</view></view>
    </view>
    <view class="muted mt">{{targets.daily.basis}}</view>
    <view class="small mt" wx:for="{{targets.daily.notes}}" wx:key="*this" style="color:var(--warn)">{{item}}</view>
  </view>

  <view class="card">
    <view class="card-title">健康资料</view>
    <view class="field"><text class="label">昵称</text><input class="input" value="{{form.nickname}}" data-k="nickname" bindinput="onField" /></view>
    <picker range="{{sexes}}" range-key="label" value="{{sexIndex}}" bindchange="onSex">
      <view class="field"><text class="label">性别</text><text class="grow">{{sexes[sexIndex].label}}</text><text class="muted">▾</text></view>
    </picker>
    <view class="field"><text class="label">年龄</text><input class="input" type="number" value="{{form.age}}" data-k="age" bindinput="onField" /></view>
    <view class="field"><text class="label">身高 cm</text><input class="input" type="digit" value="{{form.height_cm}}" data-k="height_cm" bindinput="onField" /></view>
    <view class="field"><text class="label">体重 kg</text><input class="input" type="digit" value="{{form.weight_kg}}" data-k="weight_kg" bindinput="onField" /></view>
    <view class="field"><text class="label">体脂率 %</text><input class="input" type="digit" value="{{form.body_fat_pct}}" data-k="body_fat_pct" bindinput="onField" placeholder="可选" /></view>
    <picker range="{{meta.activity_levels}}" range-key="label" value="{{activityIndex}}" bindchange="onActivity">
      <view class="field"><text class="label">活动水平</text><text class="grow">{{meta.activity_levels[activityIndex].label}}</text><text class="muted">▾</text></view>
    </picker>
    <view class="field">
      <text class="label">目标</text>
      <view class="row wrap grow"><text wx:for="{{meta.goals}}" wx:key="key" class="tag {{form.goal === item.key ? '' : 'gray'}}" bindtap="setGoal" data-k="{{item.key}}">{{item.label}}</text></view>
    </view>
    <view class="field">
      <text class="label">人群模型</text>
      <view class="row wrap grow"><text wx:for="{{meta.dietary_groups}}" wx:key="key" class="tag {{sel.groups[item.key] ? (item.special_need ? 'warn' : '') : 'gray'}}" bindtap="toggleSel" data-group="groups" data-k="{{item.key}}">{{item.label}}</text></view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">过敏原 <text class="tag danger">硬约束 · 一票否决</text></view>
    <view class="row wrap">
      <text wx:for="{{meta.allergen_options}}" wx:key="key" class="tag {{sel.allergens[item.key] ? 'danger' : 'gray'}}" bindtap="toggleSel" data-group="allergens" data-k="{{item.key}}">{{item.label}}</text>
      <text wx:for="{{extraAllergens}}" wx:key="*this" class="tag danger" bindtap="removeExtra" data-list="extraAllergens" data-v="{{item}}">{{item}} ✕</text>
    </view>
    <view class="chat-bar mt"><input class="input" placeholder="其他过敏食材" value="{{customAllergen}}" data-k="customAllergen" bindinput="onCustom" /><button class="btn small" bindtap="addCustom" data-k="allergen">添加</button></view>

    <view class="card-title mt">口味忌口 <text class="tag warn">软约束 · 可推翻</text></view>
    <view class="row wrap">
      <text wx:for="{{meta.avoid_options}}" wx:key="key" class="tag {{sel.avoidances[item.key] ? 'warn' : 'gray'}}" bindtap="toggleSel" data-group="avoidances" data-k="{{item.key}}">{{item.label}}</text>
      <text wx:for="{{extraAvoid}}" wx:key="*this" class="tag warn" bindtap="removeExtra" data-list="extraAvoid" data-v="{{item}}">{{item}} ✕</text>
    </view>
    <view class="chat-bar mt"><input class="input" placeholder="其他不吃的食材，如 洋葱" value="{{customAvoid}}" data-k="customAvoid" bindinput="onCustom" /><button class="btn small" bindtap="addCustom" data-k="avoid">添加</button></view>
    <view class="field"><text class="label">最高辣度</text><slider class="grow" min="0" max="3" value="{{form.max_spicy}}" show-value bindchange="onSpicy" activeColor="#2f7d5b" /></view>
    <view class="field"><text class="label">爱吃</text><input class="input" value="{{likesText}}" bindinput="onLikes" placeholder="用顿号分隔，如 牛肉、西兰花" /></view>
    <button class="btn mt" bindtap="save">保存资料</button>
  </view>
  <view class="notice">{{meta.disclaimer}}</view>
</view>
