/* 消息通知 · Pixel Kitchen — a pixel mailbox. 1 art pixel = 4rpx; hard shadows only, no radius / blur / soft gradients. */

/* ---------------------------------------------------------------- mailbox header */
.card.mailbox { display: flex; align-items: center; margin-top: 16rpx; padding: 28rpx; }
.mb-bell {
  position: relative; width: 112rpx; height: 112rpx; flex-shrink: 0; margin: 4rpx 28rpx 4rpx 4rpx;
  display: flex; align-items: center; justify-content: center; background: var(--paper-2);
  box-shadow: 0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink),
    inset -4rpx -4rpx 0 0 rgba(43, 35, 64, 0.18), inset 4rpx 4rpx 0 0 rgba(255, 255, 255, 0.6);
}
.mb-bell.has { background: #fff1b0; }
.mb-bell image { width: 80rpx; height: 80rpx; display: block; }
.mb-count {
  position: absolute; right: -20rpx; top: -20rpx; min-width: 24rpx; height: 40rpx; padding: 0 8rpx;
  display: flex; align-items: center; justify-content: center; font-size: 20rpx; color: #fff; background: var(--red);
  box-shadow: 0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink), inset -4rpx -4rpx 0 0 var(--red-d);
}
.mb-title { font-size: 40rpx; line-height: 1.4; color: var(--ink); letter-spacing: 2rpx; }
.mb-sub { font-size: 24rpx; color: var(--text-3); margin-top: 4rpx; }

/* ---------------------------------------------------------------- empty mailbox */
.card.empty-box { text-align: center; padding: 48rpx 28rpx 40rpx; }
.empty-bell { width: 96rpx; height: 96rpx; opacity: 0.4; }
.empty-text { font-size: 26rpx; color: var(--text-3); margin-top: 12rpx; }

/* ---------------------------------------------------------------- letters */
.card.letter { display: flex; align-items: flex-start; padding: 24rpx 28rpx; margin-bottom: 28rpx; }
.card.letter.read { background: var(--paper-2);
  box-shadow: 0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink),
    inset -4rpx -4rpx 0 0 var(--paper-3), inset 4rpx 4rpx 0 0 var(--paper), 8rpx 12rpx 0 0 var(--shadow); }
.lt-icon { margin-top: 4rpx; }
.mini-icon.i-off { background: var(--paper) !important; }
.mini-icon.i-off image { opacity: 0.6; }
.lt-main { min-width: 0; }
.lt-top { display: flex; align-items: center; }
.lt-title { flex: 1; min-width: 0; font-size: 30rpx; line-height: 1.5; color: var(--ink); letter-spacing: 1rpx; }
.letter.read .lt-title { color: var(--text-2); }
.lt-dot { width: 16rpx; height: 16rpx; flex-shrink: 0; margin: 4rpx 4rpx 4rpx 16rpx; background: var(--red);
  box-shadow: 0 0 0 4rpx var(--ink); }
.lt-body { font-size: 26rpx; line-height: 1.6; color: var(--text-2); margin-top: 4rpx; }
.letter.read .lt-body { color: var(--text-3); }
.lt-foot { display: flex; align-items: center; margin-top: 12rpx; }
.lt-time { font-size: 20rpx; line-height: 1.6; color: var(--text-3); }
.lt-go { display: flex; align-items: center; margin-left: auto; padding-left: 16rpx; font-size: 22rpx; color: var(--green-d); }
.lt-next { width: 24rpx; height: 24rpx; margin-left: 6rpx; }

.notice.foot { margin-top: 12rpx; }
