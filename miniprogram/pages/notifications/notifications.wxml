<px-nav title="消息通知" back />
<view class="container no-tab">
  <!-- mailbox header -->
  <view class="card hero mailbox anim-slide">
    <view class="mb-bell {{unread ? 'has' : ''}}">
      <image class="mb-img {{unread ? 'anim-wiggle' : ''}}" src="/assets/px/bell.svg" />
      <view wx:if="{{unread}}" class="mb-count px-num">{{unread > 99 ? '99+' : unread}}</view>
    </view>
    <view class="grow">
      <view class="mb-title">信箱</view>
      <view class="mb-sub">{{unread ? unread + ' 封未读' : '全部已读'}} · 共 {{items.length}} 封</view>
    </view>
  </view>

  <view class="section-title" wx:if="{{items.length}}"><text>收件</text><text class="sec-hint">点开查看详情</text></view>

  <view wx:if="{{!items.length}}" class="card empty-box anim-pop">
    <image class="empty-icon" src="/assets/px/send.svg" />
    <view class="empty-text">暂无通知</view>
  </view>

  <view wx:for="{{items}}" wx:key="id" class="card letter {{item.read ? 'read' : 'unread'}} {{index < 6 ? 'anim-slide d' + (index + 1) : ''}}"
    hover-class="px-pressed" bindtap="open" data-index="{{index}}">
    <view class="mini-icon lt-icon {{item.read ? 'i-off' : item.tone}}"><image class="lt-img" src="/assets/px/{{item.icon}}.svg" /></view>
    <view class="grow lt-main">
      <view class="lt-top">
        <text class="lt-title">{{item.title}}</text>
        <view wx:if="{{!item.read}}" class="px-led red lt-led"><view class="px-led-core {{item.blink ? 'anim-blink' : ''}}"></view></view>
      </view>
      <view class="lt-body">{{item.body}}</view>
      <view class="lt-foot">
        <text class="px-num lt-time">{{item.time}}</text>
        <view wx:if="{{item.link}}" class="lt-go">查看<image class="lt-next" src="/assets/px/ui-next.svg" /></view>
      </view>
    </view>
  </view>

  <view class="notice center foot">计划在后台生成完成后会通知你（配置订阅消息后也会推送微信通知）。</view>
</view>
