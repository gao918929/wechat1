<px-nav title="膳食计划" back />

<view class="container no-tab">
  <!-- ====================== generating: party battle screen ====================== -->
  <block wx:if="{{status !== 'done'}}">
    <view class="card feature gen-head {{status === 'failed' ? 'red' : 'purple'}} anim-slide">
      <view class="gen-top">
        <view class="gen-icon">
          <px-sprite wx:if="{{status !== 'failed'}}" name="sprite-pot" frames="4" size="80" duration="800" />
          <image wx:else class="gen-warn anim-shake" src="/assets/px/warn.svg" />
        </view>
        <view class="grow">
          <view class="gen-title">{{status === 'failed' ? '生成失败' : '四个智能体正在协作'}}</view>
          <view class="gen-stage">{{status === 'failed' ? error : '当前：' + stage}}</view>
        </view>
      </view>
      <view class="gen-track">
        <view class="gen-fill {{status === 'failed' ? 'is-fail' : 'px-loading'}}" style="width:{{status === 'failed' ? 100 : progress}}%"></view>
      </view>
      <view class="gen-foot">
        <text class="grow">{{status === 'failed' ? '可以返回修改指令后重试' : '离开页面也会继续，完成后通知你'}}</text>
        <text class="px-num gen-pct" wx:if="{{status !== 'failed'}}">{{progress}}%</text>
      </view>
    </view>

    <view class="section-title"><text>出战小队</text><text class="sec-hint"><text class="px-num squad-count">{{doneCount}}/4</text> 已完成</text></view>
    <view class="squad">
      <view wx:for="{{agents}}" wx:key="key" class="hero-wrap anim-slide {{'d' + (index + 1)}}">
        <view class="hero {{item.done ? 'done' : ''}}">
          <view class="hero-top">
            <view class="hero-cell agent-{{item.key}}">
              <px-sprite name="sprite-{{item.key}}" frames="2" size="96" duration="900" playing="{{!item.done && status !== 'failed'}}" />
            </view>
            <view class="hero-id">
              <view class="nameplate">{{item.title}}</view>
              <view class="hero-role">{{item.role}}</view>
            </view>
          </view>
          <view class="hero-state">
            <view wx:if="{{item.done}}" class="state-done anim-pop">
              <image class="state-icon" src="/assets/px/check.svg" /><text>完成!</text>
            </view>
            <view wx:elif="{{status === 'failed'}}" class="state-stop">已中止</view>
            <view wx:else class="state-think pulse">思考中…</view>
            <text class="hero-mode" wx:if="{{item.done}}">{{item.mode === 'llm' ? 'LLM' : '规则'}}</text>
          </view>
          <view class="hero-say">
            <px-typewriter wx:if="{{item.done}}" text="{{item.summary}}" speed="30" step="2" cursor="{{false}}" />
            <text wx:else class="hero-wait">{{status === 'failed' ? '这位伙伴还没给出结论' : '正在独立调用模型…'}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="section-title" wx:if="{{log.length}}"><text>协作过程</text></view>
    <view class="px-dialog gen-log" wx:if="{{log.length}}">
      <view wx:for="{{log}}" wx:key="index" class="log-row anim-slide-x">
        <view class="log-mark {{item.kind}}"></view>
        <text class="log-text">{{item.text}}</text>
      </view>
    </view>

    <view class="section-title" wx:if="{{streamDays.length}}"><text>菜单生成中</text><text class="sec-hint">已出 {{streamDays.length}} 天</text></view>
    <view class="card flush" wx:if="{{streamDays.length}}">
      <view wx:for="{{streamDays}}" wx:for-item="day" wx:key="day" class="stream-row anim-slide-x">
        <view class="px-cal sm">
          <view class="px-cal-top">{{day.week}}</view>
          <view class="px-num px-cal-day">{{day.dayNum}}</view>
        </view>
        <view class="grow stream-dishes"><block wx:for="{{day.meals}}" wx:for-item="m" wx:key="meal"><text wx:for="{{m.dishes}}" wx:key="name" class="stream-dish">{{item.name}}</text></block></view>
      </view>
    </view>
    <button class="btn mt" wx:if="{{status === 'failed'}}" bindtap="retry" hover-class="px-pressed">
      <image class="btn-icon back-icon" src="/assets/px/ui-back.svg" />返回重试
    </button>
  </block>

  <!-- ====================== result ====================== -->
  <block wx:if="{{status === 'done' && variant}}">
    <view class="tabs" wx:if="{{variants.length > 1}}">
      <view wx:for="{{variants}}" wx:key="key" class="tab {{active === item.key ? 'active' : ''}}" bindtap="onTab" data-key="{{item.key}}" hover-class="px-pressed">{{item.title}}</view>
    </view>

    <!-- green status window: totals + budget HP bar -->
    <view class="card feature sum anim-slide">
      <view class="sum-head">
        <text class="sum-title">{{variant.title}}</text>
        <view class="tag glass sum-check">
          <image class="tag-icon" src="/assets/px/{{variant.validation.passed ? 'check' : 'warn'}}.svg" />{{variant.validation.passed ? '三层校验通过' : '部分约束未满足'}}
        </view>
      </view>
      <view class="sum-trade">{{variant.tradeoff}}</view>
      <view class="sum-main">
        <image class="sum-coin anim-coin" src="/assets/px/coin.svg" />
        <view class="grow">
          <view class="sum-lbl">预计采购</view>
          <view class="px-num sum-total {{variant.costLong ? 'is-long' : ''}}">¥{{variant.costText}}</view>
        </view>
        <view class="sum-side">
          <view class="side-stat"><text class="side-lbl">人均</text><text class="px-num side-num">¥{{variant.perPersonText}}</text></view>
          <view class="side-stat"><text class="side-lbl">预算</text><text class="px-num side-num">{{variant.summary.budget_total ? '¥' + variant.summary.budget_total : '—'}}</text></view>
        </view>
      </view>
      <view class="sum-budget" wx:if="{{variant.summary.budget_total}}">
        <view class="budget-line">
          <text>预算血条</text>
          <text class="px-num budget-pct {{variant.budgetPct > 100 ? 'is-over anim-shake' : ''}}">{{variant.budgetPct}}%</text>
        </view>
        <px-meter value="{{variant.budgetPct}}" segments="12" color="yellow" height="28" />
      </view>
      <view class="near-row" wx:if="{{variant.nearUsed.length}}">
        <view class="near-lbl"><image class="near-icon" src="/assets/px/clock.svg" /><text>临期先用</text></view>
        <view class="near-tags"><text class="tag glass near-tag" wx:for="{{variant.nearUsed}}" wx:key="*this">{{item}}</text></view>
      </view>
      <view class="btn-row sum-btns">
        <button class="btn light {{chosen === active ? 'is-chosen' : ''}}" bindtap="choose" hover-class="px-pressed">
          <image class="btn-icon {{chosen === active ? 'anim-pop' : ''}}" src="/assets/px/{{chosen === active ? 'check' : 'star'}}.svg" />{{chosen === active ? '已选用' : '选用此方案'}}
        </button>
        <button class="btn light" bindtap="shopping" hover-class="px-pressed">
          <image class="btn-icon" src="/assets/px/cart.svg" />购物清单
        </button>
      </view>
    </view>

    <view class="card note note-warn anim-shake" wx:if="{{!variant.validation.passed}}">
      <view class="note-title"><image class="note-icon" src="/assets/px/warn.svg" /><text>还差一点</text></view>
      <view class="note-line" wx:for="{{variant.issues}}" wx:key="*this"><view class="bullet"></view><text>{{item}}</text></view>
      <view class="note-sub" wx:if="{{variant.validation.suggestions}}">可以这样调整</view>
      <view class="note-line" wx:for="{{variant.validation.suggestions.tips}}" wx:key="*this"><image class="tip-icon" src="/assets/px/ui-next.svg" /><text>{{item}}</text></view>
      <view class="note-ok" wx:if="{{variant.satisfiedText}}"><image class="tag-icon" src="/assets/px/check.svg" />已满足：{{variant.satisfiedText}}</view>
    </view>
    <view class="card note note-warn" wx:if="{{variant.nearUnused}}">
      <view class="note-title"><image class="note-icon" src="/assets/px/clock.svg" /><text>未用完的临期食材</text></view>
      <view class="note-text">{{variant.nearUnused}}</view>
    </view>

    <view class="card note" wx:if="{{result.differentiated}}">
      <view class="note-title"><image class="note-icon" src="/assets/px/users.svg" /><text>差异化多菜</text></view>
      <view class="note-line" wx:for="{{result.diff_reasons}}" wx:key="*this"><view class="bullet"></view><text>{{item}}</text></view>
      <view class="note-foot">每道菜标注“适合谁”，大家自由组合上桌。</view>
    </view>

    <view class="section-title"><text>每日菜单</text><text class="sec-hint">{{result.days}} 天 · 点菜名看做法</text></view>
    <view class="card day-card" wx:for="{{days}}" wx:for-item="day" wx:key="day">
      <view class="day-head">
        <view class="px-cal">
          <view class="px-cal-top">{{day.week}}</view>
          <view class="px-num px-cal-day">{{day.dayNum}}</view>
        </view>
        <view class="grow">
          <view class="day-title">第 {{day.day}} 天<text class="day-date">{{day.month}}{{day.dayNum}}日</text></view>
          <view class="day-meta">{{day.dishCount}} 道菜 · 食材约 <text class="px-num day-cost">¥{{day.costText}}</text></view>
        </view>
      </view>
      <view wx:for="{{day.meals}}" wx:for-item="m" wx:key="meal" class="meal">
        <view class="meal-head">
          <text class="meal-label">{{m.label}}</text>
          <view class="grow meal-rule"></view>
          <text class="px-num meal-cost">¥{{m.costText}}</text>
          <view class="eat" bindtap="eat" data-day="{{day.day}}" data-meal="{{m.meal}}" hover-class="px-pressed">
            <image class="eat-icon" src="/assets/px/meal.svg" /><text>吃了</text>
          </view>
        </view>
        <view wx:for="{{m.dishes}}" wx:for-item="x" wx:key="name" class="dish">
          <view class="dish-row">
            <view class="kind-block k-{{x.kind}}">{{x.kindShort}}</view>
            <view class="grow dish-main" bindtap="toggleDish" data-k="{{day.day}}-{{m.meal}}-{{x.name}}" hover-class="px-pressed-row">
              <view class="dish-top">
                <text class="dish-name">{{x.name}}</text>
                <text class="dish-kind">{{x.kindLabel}}</text>
              </view>
              <view class="dish-meta">{{x.kcal}} kcal · 蛋白 {{x.protein}}g / 份<text wx:if="{{x.invText}}" class="inv-hint"> · 用库存 {{x.invText}}</text></view>
            </view>
            <view class="more" bindtap="dishActions" data-day="{{day.day}}" data-meal="{{m.meal}}" data-name="{{x.name}}" data-kind="{{x.kind}}" hover-class="px-pressed">
              <view class="more-dots"></view>
            </view>
          </view>
          <view class="dish-tags" wx:if="{{x.label || x.notesText}}">
            <text class="tag warn" wx:if="{{x.label}}">{{x.label}}</text>
            <text class="tag gray" wx:if="{{x.notesText}}">替换 {{x.notesText}}</text>
          </view>
          <view wx:if="{{expanded[day.day + '-' + m.meal + '-' + x.name]}}" class="recipe anim-slide">
            <view class="recipe-facts">
              <text>共 {{x.servings}} 份</text>
              <text class="recipe-sep">·</text>
              <text>¥{{x.costText}}{{x.cost_estimated ? '（估算）' : ''}}</text>
              <text class="recipe-sep">·</text>
              <image class="recipe-icon" src="/assets/px/clock.svg" /><text>{{x.minutes}} 分钟</text>
            </view>
            <view class="recipe-ings"><text class="tag gray" wx:for="{{x.ingredients}}" wx:for-item="ing" wx:key="name">{{ing.name}} {{ing.grams}}g</text></view>
            <view class="recipe-steps">{{x.steps}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="card rate-card">
      <view class="rate-title">这周的计划怎么样？</view>
      <view class="stars">
        <view wx:for="{{[1,2,3,4,5]}}" wx:key="*this" class="star-btn" bindtap="rate" data-s="{{item}}" hover-class="star-down">
          <image class="star-img {{rating >= item ? 'anim-pop' : ''}}" style="animation-delay:{{(item - 1) * 60}}ms" src="/assets/px/{{rating >= item ? 'star' : 'star-off'}}.svg" />
        </view>
      </view>
      <view class="rate-hint">评分、收藏、删除、替换都会写入数字孪生，下周会更懂你</view>
    </view>

    <view class="section-title">
      <text>智能体分析</text>
      <view class="fold" bindtap="toggleDetails" hover-class="px-pressed">{{showDetails ? '收起' : '展开'}}</view>
    </view>
    <view class="card flush">
      <view wx:for="{{agentRows}}" wx:key="key" class="agent-row">
        <view class="agent-face agent-{{item.key}}">
          <px-sprite name="sprite-{{item.key}}" frames="2" size="72" playing="{{false}}" />
        </view>
        <view class="grow">
          <view class="agent-head">
            <text class="agent-name">{{item.title}}智能体</text>
            <text class="tag {{item.mode === 'llm' ? '' : 'gray'}}">{{item.mode === 'llm' ? 'LLM' : '规则'}}</text>
          </view>
          <view class="agent-say {{showDetails ? '' : 'is-clamped'}}">
            <px-typewriter text="{{item.summary}}" speed="30" step="2" cursor="{{false}}" />
          </view>
        </view>
      </view>
    </view>
    <view wx:if="{{showDetails}}" class="card detail anim-slide">
      <view class="detail-line" wx:if="{{conflictsText}}"><image class="detail-icon" src="/assets/px/loop.svg" /><text>取舍：{{conflictsText}}</text></view>
      <view class="detail-line" wx:if="{{result.excluded.length}}"><image class="detail-icon" src="/assets/px/shield.svg" /><text>已排除 {{result.excluded.length}} 道菜，例如 {{result.excluded[0].dish}}（{{result.excluded[0].reason}}）</text></view>
      <view class="detail-line is-warn" wx:for="{{result.warnings}}" wx:key="*this"><image class="detail-icon" src="/assets/px/warn.svg" /><text>{{item}}</text></view>
      <view class="detail-foot">模型调用 <text class="px-num">{{result.llm_usage.calls}}</text> 次 · {{result.mode === 'llm' ? 'DeepSeek 多智能体' : '离线规则引擎'}}{{result.cached ? ' · 缓存复用' : ''}}</view>
    </view>
    <view class="notice">{{variant.label}}。{{result.disclaimer}}</view>
  </block>
</view>
