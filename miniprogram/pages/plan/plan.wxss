.gen-head .muted { margin-top: 6rpx; }
.gen-spark { width: 72rpx; height: 72rpx; margin-right: 22rpx; }
.gen-title { font-size: 36rpx; font-weight: 800; letter-spacing: -0.5rpx; }
.gen-bar { background: rgba(255, 255, 255, 0.25); }
.gen-bar .fill { background: #fff; transition: width 0.5s ease; }

.agent-grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.agent-tile {
  width: calc(50% - 12rpx); box-sizing: border-box; margin-bottom: 24rpx; padding: 26rpx; border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.55); border: 1rpx solid rgba(255, 255, 255, 0.75);
  -webkit-backdrop-filter: blur(24px); backdrop-filter: blur(24px);
  box-shadow: 0 14rpx 36rpx rgba(17, 40, 30, 0.06); opacity: 0.75; transition: opacity 0.3s;
}
.agent-tile.done { opacity: 1; }
.agent-tile .mini-icon { margin-right: 0; }
.agent-sum { font-size: 24rpx; color: var(--text-2); margin-top: 12rpx; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }

.tl-row { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid var(--line); }
.tl-row:last-child { border-bottom: none; }
.tl-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: var(--blue); margin-right: 20rpx; flex-shrink: 0; }
.tl-dot.ok { background: var(--accent); }
.tl-dot.warn { background: var(--orange); }

.sum-title { font-size: 38rpx; font-weight: 800; letter-spacing: -0.5rpx; }
.sum-stats { margin: 28rpx 0 18rpx; }
.glass-bar { height: 12rpx; border-radius: 999rpx; background: rgba(255, 255, 255, 0.25); overflow: hidden; }
.glass-fill { height: 100%; border-radius: 999rpx; background: #fff; }
.glass-btn { background: rgba(255, 255, 255, 0.2) !important; color: #fff !important; box-shadow: none !important; border: 1rpx solid rgba(255, 255, 255, 0.4); }

.day-card { padding-top: 26rpx; }
.day-head { padding-bottom: 18rpx; border-bottom: 1rpx solid var(--line); margin-bottom: 6rpx; }
.day-badge { width: 84rpx; height: 84rpx; border-radius: 26rpx; margin-right: 22rpx; flex-shrink: 0; background: var(--accent-grad); color: #fff; display: flex; flex-direction: column; align-items: center; justify-content: center; box-shadow: 0 10rpx 22rpx rgba(29, 158, 108, 0.28); }
.day-badge .d { font-size: 34rpx; font-weight: 800; line-height: 1; }
.day-badge .w { font-size: 18rpx; opacity: 0.85; margin-top: 4rpx; }
.small-badge { width: 68rpx; height: 68rpx; border-radius: 22rpx; box-shadow: none; }
.small-badge .d { font-size: 28rpx; }

.meal { padding-top: 16rpx; }
.meal-head { padding: 10rpx 0; }
.meal-label { font-size: 24rpx; font-weight: 700; color: var(--text-3); letter-spacing: 2rpx; }
.eat { margin-left: 18rpx; padding: 6rpx 20rpx; border-radius: 999rpx; background: var(--accent-tint); color: var(--accent); font-size: 22rpx; font-weight: 600; }
.dish { padding: 18rpx 0; }
.dish-name { font-size: 30rpx; font-weight: 600; }
.kind { font-size: 20rpx; color: var(--text-3); margin-left: 12rpx; padding: 2rpx 10rpx; border-radius: 8rpx; background: var(--fill); }
.inv-hint { color: var(--accent); }
.kind-dot { width: 12rpx; height: 56rpx; border-radius: 6rpx; margin-right: 20rpx; flex-shrink: 0; background: var(--accent); }
.k-main, .k-one_pot { background: linear-gradient(180deg, #ff9fa8, #ef5b6a); }
.k-veg { background: linear-gradient(180deg, #7ee2a8, #2bb673); }
.k-soup { background: linear-gradient(180deg, #8fd0ff, #3b8ef0); }
.k-staple, .k-breakfast { background: linear-gradient(180deg, #ffd88a, #f2a33a); }
.more { padding: 10rpx 6rpx 10rpx 20rpx; color: var(--text-3); font-weight: 800; letter-spacing: 2rpx; }
.dish-tags { padding: 8rpx 0 0 32rpx; }
.recipe { margin: 14rpx 0 0 32rpx; padding: 20rpx 24rpx; border-radius: 24rpx; background: var(--fill); }

.stars { margin: 18rpx 0 10rpx; }
.star { font-size: 56rpx; margin: 0 10rpx; color: rgba(120, 128, 122, 0.25); }
.star.on { color: #ffb020; }
.agent-row { display: flex; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid var(--line); }
.agent-row:last-child { border-bottom: none; }
