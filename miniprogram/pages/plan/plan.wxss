/* 膳食计划 · Pixel Kitchen — "party battle" while generating, quest-reward screen when done.
   1 art pixel = 4rpx; notched outlines via 4 box-shadows; hard shadows only; no radius / blur / soft gradients. */

/* ================================================================ generating */
.gen-head { padding: 24rpx 28rpx 22rpx; }
/* failed: global red status window (.card.feature.red) */
.gen-top { display: flex; align-items: center; }
.gen-icon {
  width: 96rpx; height: 96rpx; flex-shrink: 0; margin: 4rpx 24rpx 4rpx 4rpx; box-sizing: border-box;
  display: flex; align-items: center; justify-content: center; background: var(--paper);
  box-shadow:
    0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink),
    inset 4rpx 4rpx 0 0 var(--paper-3);
}
.gen-warn { width: 64rpx; height: 64rpx; }
.gen-title { font-size: 36rpx; line-height: 1.4; letter-spacing: 2rpx; color: #ffffff; }
.gen-stage { margin-top: 4rpx; font-size: 24rpx; line-height: 1.5; color: #f1eaff; }
.gen-head.red .gen-stage { color: #ffe9e3; }
/* progress: sunken ink track + marching stripes (global .px-loading) */
.gen-track {
  box-sizing: border-box; height: 24rpx; margin: 28rpx 4rpx 4rpx; padding: 4rpx; background: var(--ink-2);
  box-shadow: 0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink);
}
.gen-fill { height: 100%; }
.gen-fill.px-loading { margin: 0; box-shadow: inset 0 4rpx 0 0 rgba(255, 255, 255, 0.35); }
.gen-fill.is-fail { background: var(--red-l); }
.gen-foot { display: flex; align-items: center; margin-top: 16rpx; font-size: 22rpx; color: #f1eaff; }
.gen-head.red .gen-foot { color: #ffe9e3; }
.gen-pct { flex-shrink: 0; margin-left: 16rpx; font-size: 24rpx; color: #ffffff; }

/* ---------------------------------------------------------------- the 2 x 2 squad */
.squad-count { font-size: 20rpx; color: var(--green-d); }
.squad { display: flex; flex-wrap: wrap; justify-content: space-between; }
.hero-wrap { width: calc(50% - 14rpx); display: flex; margin-bottom: 32rpx; }
.hero {
  flex: 1; min-width: 0; margin: 4rpx; padding: 20rpx 20rpx 22rpx; background: var(--paper-2);
  box-shadow:
    0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink),
    inset -4rpx -4rpx 0 0 var(--paper-3), inset 4rpx 4rpx 0 0 #ffffff, 6rpx 8rpx 0 0 var(--shadow);
}
.hero.done { background: var(--paper); }
.hero-top { display: flex; align-items: center; }
.hero-cell {
  width: 104rpx; height: 104rpx; flex-shrink: 0; margin: 4rpx 16rpx 4rpx 4rpx; box-sizing: border-box;
  display: flex; align-items: center; justify-content: center;
  box-shadow:
    0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink),
    inset -4rpx -4rpx 0 0 rgba(43, 35, 64, 0.18), inset 4rpx 4rpx 0 0 rgba(255, 255, 255, 0.6);
}
.hero-id { flex: 1; min-width: 0; }
/* RPG name plate */
.nameplate {
  display: inline-block; padding: 2rpx 12rpx; font-size: 24rpx; line-height: 1.5; letter-spacing: 1rpx; white-space: nowrap;
  color: var(--paper); background: var(--ink); box-shadow: 4rpx 4rpx 0 0 var(--shadow);
}
.hero-role { margin-top: 8rpx; font-size: 22rpx; color: var(--text-3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.hero-state { display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; min-height: 40rpx; }
.state-done { display: flex; align-items: center; font-size: 26rpx; color: var(--green-d); letter-spacing: 2rpx; }
.state-icon { width: 32rpx; height: 32rpx; margin-right: 8rpx; }
.state-think { font-size: 24rpx; color: var(--purple-d); letter-spacing: 2rpx; }
.state-stop { font-size: 24rpx; color: var(--text-3); letter-spacing: 2rpx; }
.hero-mode { font-size: 20rpx; color: var(--text-3); padding: 0 8rpx; background: var(--paper-2); box-shadow: 0 0 0 2rpx var(--paper-3); }
.hero-say {
  margin-top: 12rpx; padding-top: 12rpx; border-top: 4rpx dashed var(--paper-3);
  font-size: 24rpx; line-height: 1.6; color: var(--text-2);
  display: -webkit-box; -webkit-line-clamp: 5; -webkit-box-orient: vertical; overflow: hidden;
}
.hero-wait { color: var(--text-3); }

/* ---------------------------------------------------------------- log (dark dialogue) */
.gen-log { padding: 24rpx 28rpx 20rpx; }
.log-row { display: flex; align-items: flex-start; padding: 6rpx 0; font-size: 24rpx; line-height: 1.6; }
.log-mark { width: 12rpx; height: 12rpx; flex-shrink: 0; margin: 14rpx 16rpx 0 0; background: var(--blue); }
.log-mark.ok { background: var(--green); }
.log-mark.warn { background: var(--orange); }
.log-text { flex: 1; min-width: 0; color: var(--paper); }

/* ---------------------------------------------------------------- streamed days */
.stream-row { display: flex; align-items: center; padding: 18rpx 0; border-bottom: 4rpx dashed var(--paper-3); }
.stream-row:last-child { border-bottom: none; }
.stream-dishes { font-size: 24rpx; line-height: 1.7; color: var(--text-2); }
.stream-dish { margin-right: 20rpx; }


/* ================================================================ result */
/* summary window */
.sum { padding: 24rpx 28rpx 28rpx; }
.sum-head { display: flex; align-items: flex-start; justify-content: space-between; }
.sum-title { flex: 1; min-width: 0; font-size: 36rpx; line-height: 1.4; letter-spacing: 2rpx; color: #ffffff; }
.tag.sum-check { flex-shrink: 0; margin: 8rpx 4rpx 4rpx 16rpx; }
.tag-icon { width: 32rpx; height: 32rpx; vertical-align: -8rpx; margin-right: 6rpx; }
.sum-trade { margin-top: 8rpx; font-size: 24rpx; line-height: 1.6; color: #eafbe6; }
.sum-main {
  display: flex; align-items: center; margin: 24rpx 4rpx 4rpx; padding: 16rpx 20rpx; background: var(--green-d);
  box-shadow: inset 4rpx 4rpx 0 0 rgba(43, 35, 64, 0.3), inset -4rpx -4rpx 0 0 rgba(255, 255, 255, 0.15);
}
.sum-coin { width: 64rpx; height: 64rpx; flex-shrink: 0; margin-right: 16rpx; }
.sum-lbl { font-size: 22rpx; color: #eafbe6; }
.sum-total { font-size: 40rpx; line-height: 1.4; color: var(--yellow); text-shadow: 4rpx 4rpx 0 var(--ink); }
.sum-total.is-long { font-size: 32rpx; }
.sum-side { flex-shrink: 0; margin-left: 12rpx; padding-left: 16rpx; border-left: 4rpx dashed rgba(255, 255, 255, 0.35); }
.side-stat { display: flex; align-items: baseline; justify-content: space-between; line-height: 1.8; }
.side-lbl { font-size: 22rpx; color: #eafbe6; margin-right: 12rpx; }
.side-num { font-size: 20rpx; color: #ffffff; }
.sum-budget { margin-top: 20rpx; }
.budget-line { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; font-size: 22rpx; color: #eafbe6; }
.budget-pct { font-size: 20rpx; color: #ffffff; }
.budget-pct.is-over { padding: 4rpx 8rpx; color: #ffffff; background: var(--red); text-shadow: 2rpx 2rpx 0 var(--red-d); box-shadow: 0 0 0 4rpx var(--ink); }
.near-row { display: flex; align-items: flex-start; margin-top: 20rpx; }
.near-lbl { display: flex; align-items: center; flex-shrink: 0; margin: 8rpx 16rpx 0 0; font-size: 22rpx; line-height: 1.6; color: #ffffff; }
.near-icon { width: 32rpx; height: 32rpx; margin-right: 8rpx; }
.near-tags { flex: 1; min-width: 0; display: flex; flex-wrap: wrap; }
.tag.near-tag { margin: 8rpx 16rpx 8rpx 2rpx; }
.sum-btns { margin-top: 28rpx; }
.sum-btns .btn { padding: 20rpx 12rpx; font-size: 28rpx; text-shadow: none; }
/* ui-back is 12px art: 24rpx keeps it 1:1 */
.btn-icon.back-icon { width: 24rpx; height: 24rpx; vertical-align: -2rpx; }
/* chosen variant: selection = yellow */
.btn.light.is-chosen {
  background: var(--yellow); color: var(--ink);
  box-shadow:
    0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink),
    inset -4rpx -6rpx 0 0 var(--yellow-d), inset 4rpx 4rpx 0 0 #fff4b8, 6rpx 8rpx 0 0 var(--shadow);
}

/* notes (validation, leftovers, differentiated) */
.note { padding: 24rpx 28rpx; }
.note-warn {
  box-shadow:
    0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink),
    inset 8rpx 0 0 0 var(--orange), inset -4rpx -4rpx 0 0 var(--paper-3), inset 4rpx 4rpx 0 0 #ffffff, 8rpx 12rpx 0 0 var(--shadow);
}
.note-title { display: flex; align-items: center; font-size: 28rpx; letter-spacing: 2rpx; margin-bottom: 12rpx; }
.note-icon { width: 32rpx; height: 32rpx; flex-shrink: 0; margin-right: 12rpx; }
.note-line { display: flex; align-items: flex-start; font-size: 26rpx; line-height: 1.6; color: var(--text-2); padding: 4rpx 0; }
.bullet { width: 8rpx; height: 8rpx; flex-shrink: 0; margin: 16rpx 16rpx 0 8rpx; background: var(--ink); }
.tip-icon { width: 16rpx; height: 16rpx; flex-shrink: 0; margin: 12rpx 12rpx 0 4rpx; }
.note-sub { margin-top: 12rpx; font-size: 26rpx; color: var(--text); }
.note-ok { margin-top: 12rpx; font-size: 22rpx; color: var(--green-d); }
.note-text { font-size: 26rpx; color: var(--orange-d); }
.note-foot { margin-top: 12rpx; font-size: 22rpx; color: var(--text-3); }

/* day cards */
.day-card { padding: 24rpx 28rpx 12rpx; }
.day-head { display: flex; align-items: center; padding-bottom: 20rpx; border-bottom: 4rpx solid var(--ink); }
.day-title { font-size: 30rpx; color: var(--text); letter-spacing: 2rpx; }
.day-date { margin-left: 14rpx; font-size: 22rpx; color: var(--text-3); letter-spacing: 0; }
.day-meta { margin-top: 4rpx; font-size: 22rpx; color: var(--text-3); }
.day-cost { font-size: 20rpx; color: var(--orange-d); }

.meal { padding-top: 16rpx; }
.meal-head { display: flex; align-items: center; padding: 8rpx 0 4rpx; }
.meal-label { padding: 0 12rpx; font-size: 22rpx; line-height: 36rpx; letter-spacing: 2rpx; color: var(--paper); background: var(--ink-2); }
.meal-rule { height: 4rpx; margin: 0 16rpx; background-image: repeating-linear-gradient(90deg, var(--paper-3) 0, var(--paper-3) 12rpx, transparent 12rpx, transparent 20rpx); }
.meal-cost { flex-shrink: 0; font-size: 20rpx; color: var(--text-2); }
.eat {
  display: flex; align-items: center; flex-shrink: 0; margin: 4rpx 4rpx 4rpx 20rpx; padding: 4rpx 14rpx 4rpx 8rpx;
  font-size: 22rpx; line-height: 1.6; color: var(--green-d); background: var(--green-l);
  box-shadow:
    0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink),
    inset -4rpx -4rpx 0 0 rgba(46, 125, 70, 0.35), 4rpx 6rpx 0 0 var(--shadow);
}
.eat-icon { width: 32rpx; height: 32rpx; margin-right: 6rpx; }

.dish { padding: 14rpx 0; border-bottom: 4rpx dashed var(--paper-2); }
.dish:last-child { border-bottom: none; }
.dish-row { display: flex; align-items: center; }
/* category colour block (like an item-type badge) */
.kind-block {
  width: 48rpx; height: 48rpx; flex-shrink: 0; margin: 4rpx 20rpx 4rpx 4rpx;
  display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: #ffffff;
  background: var(--green); text-shadow: 2rpx 2rpx 0 rgba(43, 35, 64, 0.45);
  box-shadow:
    0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink),
    inset -4rpx -4rpx 0 0 rgba(43, 35, 64, 0.25), inset 4rpx 4rpx 0 0 rgba(255, 255, 255, 0.4);
}
.k-main { background: var(--red); }
.k-veg { background: var(--green); }
.k-soup { background: var(--blue); }
.k-staple { background: var(--yellow); color: var(--ink); text-shadow: none; }
.k-one_pot { background: var(--orange); }
.k-breakfast { background: var(--pink); }
.dish-main { padding: 4rpx 0; }
.dish-top { display: flex; align-items: baseline; }
.dish-name { font-size: 30rpx; color: var(--text); letter-spacing: 1rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.dish-kind { flex-shrink: 0; margin-left: 12rpx; font-size: 20rpx; color: var(--text-3); }
.dish-meta { font-size: 22rpx; line-height: 1.6; color: var(--text-3); }
.inv-hint { color: var(--green-d); }
.more {
  width: 56rpx; height: 48rpx; flex-shrink: 0; margin: 4rpx 4rpx 4rpx 16rpx; position: relative; background: var(--paper);
  box-shadow:
    0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink),
    inset -4rpx -4rpx 0 0 var(--paper-3), 4rpx 6rpx 0 0 var(--shadow);
}
/* three pixel dots */
.more-dots { position: absolute; left: 12rpx; top: 20rpx; width: 8rpx; height: 8rpx; background: var(--ink); box-shadow: 12rpx 0 0 0 var(--ink), 24rpx 0 0 0 var(--ink); }
.dish-tags { padding: 8rpx 0 0 72rpx; }
.recipe {
  margin: 14rpx 4rpx 8rpx 76rpx; padding: 18rpx 20rpx; background: var(--paper-2);
  box-shadow: 0 -4rpx 0 0 var(--paper-3), 0 4rpx 0 0 var(--paper-3), -4rpx 0 0 0 var(--paper-3), 4rpx 0 0 0 var(--paper-3), inset 4rpx 4rpx 0 0 var(--paper-3);
}
.recipe-facts { display: flex; align-items: center; flex-wrap: wrap; font-size: 24rpx; color: var(--text-2); }
.recipe-sep { margin: 0 10rpx; color: var(--text-3); }
.recipe-icon { width: 32rpx; height: 32rpx; margin-right: 6rpx; }
.recipe-ings { margin-top: 10rpx; }
.recipe-steps { margin-top: 10rpx; font-size: 24rpx; line-height: 1.7; color: var(--text); }

/* rating */
.rate-card { text-align: center; padding: 28rpx 28rpx 24rpx; }
.rate-title { font-size: 30rpx; color: var(--text); letter-spacing: 2rpx; }
.stars { display: flex; justify-content: center; margin: 20rpx 0 16rpx; }
.star-btn { padding: 8rpx 12rpx; }
.star-down { transform: translateY(4rpx); }
.star-img { display: block; width: 64rpx; height: 64rpx; }
.rate-hint { font-size: 22rpx; line-height: 1.7; color: var(--text-3); }

/* agent analysis */
.fold {
  flex-shrink: 0; margin: 4rpx; padding: 2rpx 16rpx; font-size: 22rpx; line-height: 1.6; color: var(--green-d); background: var(--paper);
  box-shadow:
    0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink),
    inset -4rpx -4rpx 0 0 var(--paper-3), 4rpx 6rpx 0 0 var(--shadow);
}
.agent-row { display: flex; align-items: flex-start; padding: 22rpx 0; border-bottom: 4rpx dashed var(--paper-3); }
.agent-row:last-child { border-bottom: none; }
.agent-face {
  width: 80rpx; height: 80rpx; flex-shrink: 0; margin: 4rpx 20rpx 4rpx 4rpx; box-sizing: border-box;
  display: flex; align-items: center; justify-content: center;
  box-shadow:
    0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink),
    inset -4rpx -4rpx 0 0 rgba(43, 35, 64, 0.18), inset 4rpx 4rpx 0 0 rgba(255, 255, 255, 0.6);
}
.agent-head { display: flex; align-items: center; }
.agent-name { font-size: 28rpx; color: var(--text); letter-spacing: 1rpx; margin-right: 12rpx; }
.agent-say { font-size: 24rpx; line-height: 1.6; color: var(--text-2); }
.agent-say.is-clamped { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

.detail { padding: 24rpx 28rpx; }
.detail-line { display: flex; align-items: flex-start; font-size: 24rpx; line-height: 1.7; color: var(--text-2); padding: 4rpx 0; }
.detail-line.is-warn { color: var(--orange-d); }
.detail-icon { width: 32rpx; height: 32rpx; flex-shrink: 0; margin: 4rpx 12rpx 0 0; }
.detail-foot { margin-top: 12rpx; padding-top: 12rpx; border-top: 4rpx dashed var(--paper-3); font-size: 22rpx; color: var(--text-3); }
.detail-foot .px-num { font-size: 20rpx; color: var(--text-2); }
