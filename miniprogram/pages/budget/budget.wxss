.spend { font-size: 64rpx; font-weight: 800; letter-spacing: -1.5rpx; margin: 6rpx 0; }
.ring.white { background: conic-gradient(from -90deg, #ffffff 0%, rgba(255, 255, 255, 0.92) calc(var(--p) * 1%), rgba(255, 255, 255, 0.22) calc(var(--p) * 1%)); }
.ring.white.over { background: conic-gradient(from -90deg, #ffd166 0%, #ff8a3d 100%); }
.card.feature .ring-center .unit { color: rgba(255, 255, 255, 0.8); }
.ring-wrap { width: 180rpx; height: 180rpx; }
.ring-wrap .ring { width: 180rpx; height: 180rpx; }
.budget-line { display: flex; justify-content: space-between; margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid rgba(255, 255, 255, 0.25); font-size: 26rpx; color: rgba(255, 255, 255, 0.85); }
.bold-w { font-weight: 700; color: #fff; }
.stack { display: flex; height: 24rpx; border-radius: 999rpx; overflow: hidden; background: var(--fill); margin-bottom: 18rpx; }
.seg { height: 100%; }
.seg + .seg { border-left: 3rpx solid rgba(255, 255, 255, 0.9); }
.legend { display: flex; align-items: center; padding: 14rpx 0; font-size: 28rpx; }
.ldot { width: 18rpx; height: 18rpx; border-radius: 6rpx; margin-right: 18rpx; }
.amt { width: 150rpx; text-align: right; }
.c-vegetables { background: linear-gradient(90deg, #7ee2a8, #2bb673); }
.c-meat_eggs { background: linear-gradient(90deg, #ffa3a3, #ef5b6a); }
.c-seafood { background: linear-gradient(90deg, #8fd0ff, #3b8ef0); }
.c-staples { background: linear-gradient(90deg, #ffd88a, #f2a33a); }
.c-seasonings { background: linear-gradient(90deg, #c9cfcb, #8e9691); }
.c-other { background: linear-gradient(90deg, #c7b8ff, #7b68ee); }
.action-row { display: flex; gap: 20rpx; margin-bottom: 8rpx; }
.action-card { flex: 1; display: flex; align-items: center; padding: 26rpx 24rpx; border-radius: 36rpx; margin-bottom: 20rpx; background: rgba(255, 255, 255, 0.62); border: 1rpx solid rgba(255, 255, 255, 0.75); box-shadow: 0 14rpx 36rpx rgba(17, 40, 30, 0.07); }
.tx { display: flex; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid var(--line); }
.tx:last-child { border-bottom: none; }
.tx-amt { font-size: 32rpx; font-weight: 700; margin-left: 16rpx; }
