<glass-nav title="预算与记账" />
<view class="container">
  <view class="tabs">
    <view class="tab {{period === 'week' ? 'active' : ''}}" bindtap="setPeriod" data-p="week">本周</view>
    <view class="tab {{period === 'month' ? 'active' : ''}}" bindtap="setPeriod" data-p="month">本月</view>
  </view>

  <view class="card" wx:if="{{report}}">
    <view class="between">
      <view class="muted">{{report.start}} ~ {{report.end}}</view>
      <view class="muted">{{report.count}} 笔</view>
    </view>
    <view class="row mt">
      <view class="stat"><view class="num">¥{{report.totalText}}</view><view class="lbl">实际支出</view></view>
      <view class="stat"><view class="num">¥{{report.per_person}}</view><view class="lbl">人均（{{report.members}}人）</view></view>
      <view class="stat"><view class="num" style="color:{{report.over_budget ? 'var(--danger)' : 'var(--primary)'}}">{{report.budget ? '¥' + report.budget_left : '—'}}</view><view class="lbl">预算剩余</view></view>
    </view>
    <view class="bar mt" wx:if="{{report.budget}}"><view class="fill {{report.over_budget ? 'danger' : report.usePct > 85 ? 'warn' : ''}}" style="width:{{report.usePct}}%"></view></view>
    <view class="muted mt" wx:if="{{report.budget}}">预算 ¥{{report.budget}}（{{report.budget_mode === 'per_person' ? '人均预算' : '总预算'}}）</view>

    <view class="mt" wx:for="{{report.by_category}}" wx:key="category">
      <view class="between small"><text>{{item.label}}</text><text>¥{{item.amount}} · {{item.pctText}}%</text></view>
      <view class="bar"><view class="fill" style="width:{{item.pctText}}%"></view></view>
    </view>
    <view class="mt" wx:if="{{report.by_payer.length > 1}}">
      <text class="muted">谁付的：</text>
      <text class="tag gray" wx:for="{{report.by_payer}}" wx:key="user_id">{{item.nickname}} ¥{{item.amount}}</text>
    </view>
    <view class="notice">{{report.note}}；成本测算优先使用你的历史成交价。</view>
  </view>

  <view class="card">
    <view class="btn-row" style="margin-top:0">
      <button class="btn" bindtap="photo">🧾 拍小票 / 价签</button>
      <button class="btn ghost" bindtap="toggleManual">✍️ 手动记一笔</button>
    </view>
    <view wx:if="{{showManual}}" class="mt">
      <view class="field"><text class="label">实付金额</text><input class="input" type="digit" data-k="total_amount" value="{{manual.total_amount}}" bindinput="onManual" /></view>
      <view class="field"><text class="label">商家</text><input class="input" data-k="merchant" value="{{manual.merchant}}" bindinput="onManual" /></view>
      <view class="field"><text class="label">备注</text><input class="input" data-k="note" value="{{manual.note}}" bindinput="onManual" /></view>
      <button class="btn mt" bindtap="saveManual">保存</button>
    </view>
  </view>

  <view class="card" wx:if="{{isAdmin}}">
    <view class="card-title">预算设置</view>
    <view class="tabs" style="background:#f6f8f7">
      <view class="tab {{budgetMode === 'per_person' ? 'active' : ''}}" bindtap="setMode" data-m="per_person">人均预算（默认）</view>
      <view class="tab {{budgetMode === 'total' ? 'active' : ''}}" bindtap="setMode" data-m="total">总预算</view>
    </view>
    <view class="field"><text class="label">每周 ¥</text><input class="input" type="digit" value="{{budgetAmount}}" bindinput="onAmount" placeholder="{{budgetMode === 'per_person' ? '每人每周' : '小组每周合计'}}" /></view>
    <button class="btn mt" bindtap="saveBudget">保存预算</button>
  </view>

  <view class="card">
    <view class="card-title">流水</view>
    <view wx:if="{{!expenses.length}}" class="muted">暂无记录</view>
    <view wx:for="{{expenses}}" wx:key="id" class="list-item" bindtap="expenseActions" data-index="{{index}}">
      <view class="between"><text class="bold">¥{{item.total_amount}}</text><text class="muted">{{item.date}}</text></view>
      <view class="muted mt">{{item.merchant || '未填商家'}} · {{item.source === 'manual' ? '手动' : item.source === 'label' ? '价签' : '小票'}}<text wx:if="{{item.itemText}}"> · {{item.itemText}}</text></view>
    </view>
  </view>
</view>
