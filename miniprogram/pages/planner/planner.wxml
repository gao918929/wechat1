<glass-nav title="AI 计划" subtitle="四个智能体 · 一句话生成一周菜单" large />

<view class="container">
  <view class="card prompt-card">
    <view class="row mb">
      <view class="mini-icon i-purple"><image src="/assets/icons/sparkles-w.svg" /></view>
      <view class="grow"><view class="bold">告诉我你们的情况</view><view class="muted">{{group.name}} · 人数、预算、忌口、冰箱里有什么</view></view>
    </view>
    <textarea class="textarea prompt" maxlength="1000" auto-height value="{{instruction}}" bindinput="onInput"
      placeholder="例如：我在减脂，宿舍4个人，每人预算80元，不吃辣，冰箱里有快过期的鸡胸肉，帮我们规划一周晚餐" />
    <scroll-view scroll-x class="examples" enhanced show-scrollbar="{{false}}">
      <view wx:for="{{examples}}" wx:key="title" class="example" bindtap="useExample" data-i="{{index}}">
        <view class="bold">{{item.title}}</view>
        <view class="muted ex-text">{{item.text}}</view>
      </view>
    </scroll-view>
  </view>

  <view class="section-title"><text>选项</text></view>
  <view class="card flush">
    <picker range="{{dayOptions}}" bindchange="onDays">
      <view class="field"><text class="label">天数</text><text class="grow value">{{days}} 天</text><text class="chevron">›</text></view>
    </picker>
    <view class="field">
      <text class="label">餐次</text>
      <view class="seg-mini grow">
        <text class="seg-item {{meals.breakfast ? 'on' : ''}}" bindtap="toggleMeal" data-k="breakfast">早餐</text>
        <text class="seg-item {{meals.lunch ? 'on' : ''}}" bindtap="toggleMeal" data-k="lunch">午餐</text>
        <text class="seg-item {{meals.dinner ? 'on' : ''}}" bindtap="toggleMeal" data-k="dinner">晚餐</text>
      </view>
    </view>
    <view class="field"><text class="label">就餐人数</text><input class="value-input grow" type="number" value="{{people}}" bindinput="onPeople" placeholder="自动识别" /></view>
    <view class="field"><text class="label">备选方案</text><text class="grow muted">健康优先 / 预算优先</text><switch checked="{{alternatives}}" bindchange="onAlt" color="#1d9e6c" /></view>
    <view class="field" wx:if="{{avoidances.length}}">
      <text class="label">这次可以吃</text>
      <view class="row wrap grow">
        <text wx:for="{{avoidances}}" wx:key="key" class="tag {{overrides[item.key] ? 'warn' : 'gray'}}" bindtap="toggleOverride" data-k="{{item.key}}">{{overrides[item.key] ? '✓ ' : ''}}{{item.label}}</text>
      </view>
    </view>
  </view>
  <view class="notice">过敏原是硬约束，一票否决；口味忌口是软约束，默认回避，你可以推翻。</view>

  <button class="btn go-btn" bindtap="submit" disabled="{{submitting}}">
    <image class="btn-icon" src="/assets/icons/sparkles-w.svg" />{{submitting ? '正在召集智能体…' : '开始规划'}}
  </button>

  <view class="section-title"><text>历史计划</text></view>
  <view class="card flush">
    <view wx:if="{{!plans.length}}" class="empty">还没有计划</view>
    <view wx:for="{{plans}}" wx:key="id" class="hist" bindtap="open" data-id="{{item.id}}">
      <view class="hist-date"><view class="d">{{item.dateText}}</view><view class="state {{item.state}}"></view></view>
      <view class="grow">
        <view class="small ellipsis hist-text">{{item.instruction || '按小组设置生成'}}</view>
        <view class="muted" wx:if="{{item.summary}}">{{item.summary.title}} · ¥{{item.summary.total_cost}} · 人均 ¥{{item.summary.per_person_cost}}</view>
        <view class="muted" wx:else>{{item.stateText}}</view>
      </view>
      <text class="chevron">›</text>
    </view>
  </view>
</view>
