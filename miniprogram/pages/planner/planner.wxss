/* AI 计划 · Pixel Kitchen — the "take a quest" screen.
   1 art pixel = 4rpx; notched outlines via 4 box-shadows; hard shadows only; no radius / blur / soft gradients. */

/* ---------------------------------------------------------------- quest giver: chef + dialogue */
.giver { display: flex; align-items: flex-end; margin-bottom: 36rpx; }
.giver-chef {
  width: 136rpx; height: 136rpx; flex-shrink: 0; margin: 4rpx 0 4rpx 4rpx; box-sizing: border-box;
  display: flex; align-items: center; justify-content: center;
  background-color: var(--red-l);
  background-image: repeating-linear-gradient(0deg, transparent 0, transparent 28rpx, rgba(168, 50, 42, 0.12) 28rpx, rgba(168, 50, 42, 0.12) 32rpx);
  box-shadow:
    0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink),
    inset 4rpx 4rpx 0 0 rgba(43, 35, 64, 0.18), 6rpx 8rpx 0 0 var(--shadow);
}
.giver-talk { position: relative; flex: 1; min-width: 0; margin: 4rpx 4rpx 4rpx 28rpx; padding: 20rpx 24rpx 22rpx; font-size: 26rpx; line-height: 1.7; }
/* speech tail pointing at the chef: a stepped pixel triangle (16 x 32rpx, 4rpx steps) */
.giver-talk::before {
  content: ""; position: absolute; left: -20rpx; bottom: 32rpx; width: 16rpx; height: 32rpx; background: var(--ink);
  clip-path: polygon(100% 0, 100% 100%, 75% 100%, 75% 87.5%, 50% 87.5%, 50% 75%, 25% 75%, 25% 62.5%, 0 62.5%, 0 37.5%, 25% 37.5%, 25% 25%, 50% 25%, 50% 12.5%, 75% 12.5%, 75% 0);
}
.talk-who { display: flex; align-items: center; margin-bottom: 6rpx; }
.talk-name { font-size: 22rpx; color: var(--yellow); letter-spacing: 2rpx; }
.talk-group {
  margin-left: 14rpx; padding: 0 10rpx; font-size: 20rpx; line-height: 32rpx; color: var(--ink); background: var(--paper-3);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 220rpx;
}

/* ---------------------------------------------------------------- brief (textarea window) */
.brief { padding: 24rpx 28rpx 28rpx; }
.brief-head { display: flex; align-items: center; margin-bottom: 18rpx; }
.brief-icon { width: 32rpx; height: 32rpx; flex-shrink: 0; margin-right: 12rpx; }
.brief-title { flex: 1; font-size: 28rpx; color: var(--text); letter-spacing: 2rpx; }
.brief-count { font-size: 20rpx; color: var(--text-3); }
.prompt { display: block; box-sizing: border-box; width: calc(100% - 8rpx); min-height: 200rpx; font-size: 28rpx; }

/* ---------------------------------------------------------------- example quests (horizontal) */
.quests { white-space: nowrap; margin: 0 -36rpx 16rpx; padding: 8rpx 36rpx 28rpx; width: auto; box-sizing: border-box; }
.quest {
  display: inline-block; vertical-align: top; white-space: normal; box-sizing: border-box;
  width: 400rpx; margin: 4rpx 28rpx 4rpx 4rpx; background: var(--paper);
  box-shadow:
    0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink),
    inset -4rpx -4rpx 0 0 var(--paper-3), inset 4rpx 4rpx 0 0 #ffffff, 8rpx 12rpx 0 0 var(--shadow);
}
/* yellow quest banner across the top */
.quest-band {
  display: flex; align-items: center; padding: 12rpx 20rpx 14rpx; background: var(--yellow);
  box-shadow: inset 0 -4rpx 0 0 var(--ink), inset 4rpx 4rpx 0 0 #fff4b8, inset -4rpx 0 0 0 var(--yellow-d);
}
.quest-icon { width: 32rpx; height: 32rpx; flex-shrink: 0; margin-right: 12rpx; }
.quest-title { flex: 1; min-width: 0; font-size: 28rpx; color: var(--ink); letter-spacing: 1rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.quest-body { padding: 16rpx 20rpx 18rpx; }
.quest-meta { font-size: 22rpx; color: var(--purple-d); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.quest-text {
  margin-top: 8rpx; font-size: 24rpx; line-height: 1.6; color: var(--text-2); height: 76rpx;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
.quest-go { display: flex; align-items: center; justify-content: flex-end; margin-top: 10rpx; font-size: 22rpx; color: var(--green-d); letter-spacing: 2rpx; }
.quest-next { width: 16rpx; height: 16rpx; margin-left: 8rpx; }

/* ---------------------------------------------------------------- options (pixel list) */
.opts { padding: 0 28rpx; }
.opt { display: flex; align-items: center; min-height: 56rpx; padding: 22rpx 0; border-bottom: 4rpx dashed var(--paper-3); }
.opt-last { border-bottom: none; }
.opt-top { align-items: flex-start; }
.opt-icon { width: 48rpx; height: 48rpx; flex-shrink: 0; margin-right: 20rpx; }
.opt-label { width: 160rpx; flex-shrink: 0; font-size: 28rpx; color: var(--text); letter-spacing: 1rpx; }
.opt-top .opt-label, .opt .grow .opt-label { width: auto; }
.opt-sub { font-size: 22rpx; line-height: 1.5; color: var(--text-3); }
.opt-value { display: flex; align-items: baseline; justify-content: flex-end; }
.opt-num { font-size: 32rpx; color: var(--green-d); }
.opt-unit { flex-shrink: 0; margin-left: 10rpx; font-size: 24rpx; color: var(--text-2); }
.opt-next { width: 16rpx; height: 16rpx; flex-shrink: 0; margin-left: 18rpx; }

/* meal toggles: raised pixel keys, yellow = selected */
.seg { display: flex; justify-content: flex-end; }
.seg-item {
  margin: 4rpx 4rpx 4rpx 20rpx; padding: 6rpx 18rpx; font-size: 24rpx; line-height: 1.5; color: var(--text-3); background: var(--paper-2);
  box-shadow:
    0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink),
    inset -4rpx -4rpx 0 0 var(--paper-3);
}
.seg-item.on {
  color: var(--ink); background: var(--yellow);
  box-shadow:
    0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink),
    inset -4rpx -4rpx 0 0 var(--yellow-d), inset 4rpx 4rpx 0 0 #fff4b8, 4rpx 6rpx 0 0 var(--shadow);
}

/* people count: small sunken field */
.input.people { box-sizing: border-box; width: 168rpx; min-height: 52rpx; padding: 6rpx 14rpx; margin: 4rpx; font-size: 28rpx; text-align: right; flex-shrink: 0; }
.people-ph { color: var(--text-3); font-size: 24rpx; }

/* ON / OFF: global .px-toggle; only the gap to the label is local */
.alt-toggle { margin-left: 16rpx; }

/* soft avoidances that can be lifted for this plan */
.avoid-row { display: flex; flex-wrap: wrap; margin-top: 14rpx; }
.avoid {
  display: flex; align-items: center; margin: 4rpx 20rpx 12rpx 4rpx; padding: 4rpx 16rpx 4rpx 10rpx; font-size: 24rpx; line-height: 1.6;
  color: var(--text-2); background: var(--paper-2);
  box-shadow:
    0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink),
    inset -4rpx -4rpx 0 0 var(--paper-3);
}
.avoid.on {
  color: var(--orange-d); background: #ffe2b0;
  box-shadow:
    0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink),
    inset -4rpx -4rpx 0 0 #f5c27a, inset 4rpx 4rpx 0 0 #fff4dc, 4rpx 6rpx 0 0 var(--shadow);
}
.avoid-icon { width: 32rpx; height: 32rpx; flex-shrink: 0; margin-right: 8rpx; }

.rule { display: flex; align-items: flex-start; padding: 0 8rpx 32rpx; font-size: 22rpx; line-height: 1.8; color: var(--text-3); }
.rule-icon { width: 32rpx; height: 32rpx; flex-shrink: 0; margin: 4rpx 12rpx 0 0; }

/* ---------------------------------------------------------------- launch window */
.launch { padding: 24rpx 28rpx 28rpx; margin-bottom: 44rpx; }
.party-head { display: flex; justify-content: space-between; align-items: center; font-size: 26rpx; color: var(--text); letter-spacing: 2rpx; margin-bottom: 18rpx; }
.party { display: flex; justify-content: space-between; margin-bottom: 32rpx; }
.member { width: 140rpx; display: flex; flex-direction: column; align-items: center; }
.member-cell {
  width: 88rpx; height: 88rpx; margin: 4rpx 4rpx 14rpx; box-sizing: border-box;
  display: flex; align-items: center; justify-content: center;
  box-shadow:
    0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink),
    inset -4rpx -4rpx 0 0 rgba(43, 35, 64, 0.18), inset 4rpx 4rpx 0 0 rgba(255, 255, 255, 0.6);
}
.member-name { font-size: 22rpx; color: var(--text-2); white-space: nowrap; }
.go-btn { padding: 26rpx 32rpx; font-size: 32rpx; }
.go-icon { width: 48rpx; height: 48rpx; vertical-align: -12rpx; margin-right: 14rpx; }
.px-loading.launch-load { margin: 28rpx 4rpx 4rpx; height: 16rpx; }

/* ---------------------------------------------------------------- quest log */
.log-wrap { margin-bottom: 28rpx; }
.log {
  display: flex; align-items: center; margin: 4rpx; padding: 20rpx 20rpx 20rpx 20rpx; background: var(--paper);
  box-shadow:
    0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink),
    inset -4rpx -4rpx 0 0 var(--paper-3), inset 4rpx 4rpx 0 0 #ffffff, 6rpx 8rpx 0 0 var(--shadow);
}
.log-text { font-size: 28rpx; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.log-meta { display: flex; align-items: center; margin-top: 6rpx; min-width: 0; }
.tag.log-state { flex-shrink: 0; margin: 4rpx 14rpx 4rpx 2rpx; }
.log-state-icon { width: 32rpx; height: 32rpx; vertical-align: -8rpx; margin-right: 6rpx; }
.log-title { flex: 1; min-width: 0; font-size: 24rpx; color: var(--text-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.log-cost { display: flex; align-items: center; margin-top: 8rpx; }
.log-coin { width: 32rpx; height: 32rpx; flex-shrink: 0; margin-right: 10rpx; }
.log-total { font-size: 24rpx; color: var(--orange-d); }
.log-per { margin-left: 20rpx; font-size: 22rpx; color: var(--text-3); }
.log-per-num { margin-left: 8rpx; font-size: 20rpx; color: var(--text-2); }
.log-next { width: 16rpx; height: 16rpx; flex-shrink: 0; margin-left: 16rpx; }
.log-empty { display: flex; flex-direction: column; align-items: center; padding: 36rpx 28rpx 8rpx; }
.log-empty-icon { width: 64rpx; height: 64rpx; }
