.prompt-card { padding-bottom: 20rpx; }
.prompt { width: 100%; box-sizing: border-box; background: rgba(255, 255, 255, 0.7); border: 1rpx solid rgba(29, 158, 108, 0.18); }
.examples { white-space: nowrap; margin: 22rpx -32rpx 0; padding: 0 32rpx; width: auto; }
.example { display: inline-block; vertical-align: top; width: 360rpx; margin-right: 16rpx; padding: 20rpx 24rpx; border-radius: 26rpx; background: var(--fill); white-space: normal; }
.ex-text { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-top: 6rpx; }
.value { color: var(--text-2); text-align: right; }
.value-input { text-align: right; color: var(--text-2); font-size: 28rpx; }
.seg-mini { display: flex; justify-content: flex-end; }
.seg-item { margin-left: 12rpx; padding: 10rpx 26rpx; border-radius: 999rpx; background: var(--fill); color: var(--text-2); font-size: 26rpx; }
.seg-item.on { background: var(--accent-tint); color: var(--accent); font-weight: 600; }
.go-btn { margin: 8rpx 0 20rpx !important; padding: 28rpx; font-size: 32rpx; }
.hist { display: flex; align-items: center; padding: 26rpx 0; border-bottom: 1rpx solid var(--line); }
.hist:last-child { border-bottom: none; }
.hist-date { width: 96rpx; margin-right: 18rpx; text-align: center; }
.hist-date .d { font-size: 26rpx; font-weight: 700; }
.state { width: 12rpx; height: 12rpx; border-radius: 50%; margin: 8rpx auto 0; background: var(--accent); }
.state.warn { background: var(--orange); }
.state.danger { background: var(--red); }
.hist-text { color: var(--text); font-weight: 500; margin-bottom: 4rpx; }
