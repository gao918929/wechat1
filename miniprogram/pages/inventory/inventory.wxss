.nav-add { width: 76rpx; height: 76rpx; border-radius: 50%; margin-bottom: 8rpx; background: rgba(29, 158, 108, 0.12); display: flex; align-items: center; justify-content: center; }
.nav-add image { width: 40rpx; height: 40rpx; }
.action-row { display: flex; gap: 20rpx; margin-bottom: 24rpx; }
.action-card { flex: 1; display: flex; align-items: center; padding: 26rpx 24rpx; border-radius: 36rpx; background: rgba(255, 255, 255, 0.62); border: 1rpx solid rgba(255, 255, 255, 0.75); box-shadow: 0 14rpx 36rpx rgba(17, 40, 30, 0.07); }
.ask { padding: 20rpx; border-radius: 48rpx; }
.ask .reply { font-size: 26rpx; color: var(--accent); padding: 14rpx 20rpx 4rpx; }
.stats-strip { display: flex; padding: 12rpx 0 8rpx; }
.warn-num { background: linear-gradient(135deg, #ffb547, #f08a24) !important; -webkit-background-clip: text !important; background-clip: text !important; }
.inv-row { display: flex; align-items: center; padding: 26rpx 0; border-bottom: 1rpx solid var(--line); }
.inv-row:last-child { border-bottom: none; }
.meta { margin: 4rpx 0 12rpx; }
.days { font-size: 26rpx; font-weight: 700; color: var(--accent); }
.days.warn { color: var(--orange); }
.days.danger { color: var(--red); }
