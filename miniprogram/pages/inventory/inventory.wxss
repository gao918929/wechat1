/* 冰箱 · Pixel Kitchen — inventory as an RPG backpack. 1 art pixel = 4rpx, hard shadows only. */

/* ---------------------------------------------------------------- nav: add button */
.nav-add {
  width: 80rpx; height: 80rpx; margin: 0 8rpx 8rpx 0; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center; background: var(--paper);
  box-shadow:
    0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink),
    inset -4rpx -4rpx 0 0 var(--paper-3), inset 4rpx 4rpx 0 0 #fff, 6rpx 8rpx 0 0 var(--shadow);
}
.nav-add image { width: 48rpx; height: 48rpx; }

/* ---------------------------------------------------------------- bag status window */
.bag { padding: 24rpx; }
.bag-top { display: flex; align-items: center; }
.bag-hero {
  width: 136rpx; height: 136rpx; flex-shrink: 0; margin: 4rpx 24rpx 4rpx 4rpx;
  display: flex; align-items: center; justify-content: center;
  background-color: var(--blue-l);
  background-image: repeating-linear-gradient(0deg, transparent 0, transparent 28rpx, rgba(45, 111, 168, 0.12) 28rpx, rgba(45, 111, 168, 0.12) 32rpx);
  box-shadow:
    0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink),
    inset 4rpx 4rpx 0 0 rgba(43, 35, 64, 0.18);
}
.bag-stats { flex: 1; min-width: 0; display: flex; }
.bag-stat { flex: 1; min-width: 0; text-align: center; padding: 4rpx 0; }
.bag-stat + .bag-stat { border-left: 4rpx dashed var(--paper-3); }
.bag-num { font-size: 40rpx; line-height: 1.4; color: var(--green-d); }
.bag-num.is-warn { color: var(--orange-d); }
.bag-num.is-blue { color: var(--blue-d); }
.bag-lbl { font-size: 22rpx; color: var(--text-3); margin-top: 8rpx; white-space: nowrap; }

.bag-alert {
  display: flex; align-items: center; margin: 28rpx 4rpx 4rpx; padding: 10rpx 16rpx;
  background: #ffe2b0; font-size: 24rpx; color: var(--ink);
  box-shadow: 0 -4rpx 0 0 var(--orange-d), 0 4rpx 0 0 var(--orange-d), -4rpx 0 0 0 var(--orange-d), 4rpx 0 0 0 var(--orange-d);
}
.bag-alert.ok { background: var(--green-l); box-shadow: 0 -4rpx 0 0 var(--green-d), 0 4rpx 0 0 var(--green-d), -4rpx 0 0 0 var(--green-d), 4rpx 0 0 0 var(--green-d); }
.bag-alert-icon { width: 32rpx; height: 32rpx; flex-shrink: 0; margin-right: 12rpx; }
.bag-alert-key { color: var(--orange-d); margin-right: 12rpx; flex-shrink: 0; }
.bag-alert-names { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* ---------------------------------------------------------------- entry tiles */
.action-row { display: flex; gap: 28rpx; margin-bottom: 36rpx; }
.action-wrap { flex: 1; min-width: 0; }
.action-card {
  display: flex; align-items: center; padding: 22rpx 16rpx 22rpx 20rpx; margin: 4rpx; background: var(--paper);
  box-shadow:
    0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink),
    inset -4rpx -4rpx 0 0 var(--paper-3), inset 4rpx 4rpx 0 0 #fff, 8rpx 12rpx 0 0 var(--shadow);
}
.action-card .mini-icon { margin-right: 18rpx; }
.action-name { font-size: 30rpx; color: var(--text); letter-spacing: 1rpx; white-space: nowrap; }
.action-sub { font-size: 22rpx; color: var(--text-3); white-space: nowrap; }

/* ---------------------------------------------------------------- say-a-sentence */
.ask { padding: 24rpx; }
.ask-head { display: flex; align-items: center; font-size: 24rpx; color: var(--text-2); margin-bottom: 18rpx; }
.ask-icon { width: 32rpx; height: 32rpx; margin-right: 12rpx; }
.ask .input { font-size: 26rpx; }
.reply { margin: 32rpx 4rpx 8rpx; padding: 20rpx 28rpx 24rpx; font-size: 26rpx; line-height: 1.7; }
.reply-who { display: flex; align-items: center; margin-bottom: 8rpx; font-size: 22rpx; color: var(--yellow); letter-spacing: 2rpx; }
.reply-icon { width: 32rpx; height: 32rpx; flex-shrink: 0; margin-right: 10rpx; }
.member-hint { margin-top: 24rpx; padding-top: 16rpx; border-top: 4rpx dashed var(--paper-3); font-size: 22rpx; line-height: 1.7; color: var(--text-3); }

/* ---------------------------------------------------------------- backpack slots */
.slot-wrap { margin-bottom: 28rpx; }
.slot {
  display: flex; align-items: center; margin: 4rpx; padding: 20rpx 24rpx 20rpx 20rpx; background: var(--paper);
  box-shadow:
    0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink),
    inset -4rpx -4rpx 0 0 var(--paper-3), inset 4rpx 4rpx 0 0 #fff, 6rpx 8rpx 0 0 var(--shadow);
}
/* urgent rows: a coloured stripe on the left edge */
.slot.slot-warn, .slot.slot-danger { padding-left: 28rpx; }
.slot.slot-warn {
  box-shadow:
    0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink),
    inset 8rpx 0 0 0 var(--orange), inset -4rpx -4rpx 0 0 var(--paper-3), inset 4rpx 4rpx 0 0 #fff, 6rpx 8rpx 0 0 var(--shadow);
}
.slot.slot-danger {
  box-shadow:
    0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink),
    inset 8rpx 0 0 0 var(--red), inset -4rpx -4rpx 0 0 var(--paper-3), inset 4rpx 4rpx 0 0 #fff, 6rpx 8rpx 0 0 var(--shadow);
}
/* sunken item cell, like a bag slot */
.slot-cell {
  width: 96rpx; height: 96rpx; flex-shrink: 0; margin: 4rpx 24rpx 4rpx 4rpx;
  display: flex; align-items: center; justify-content: center; background: var(--paper-2);
  box-shadow:
    0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink),
    inset 4rpx 4rpx 0 0 var(--paper-3);
}
.slot-img { width: 64rpx; height: 64rpx; }
.avatar.slot-avatar { width: 60rpx; height: 60rpx; margin: 0; font-size: 30rpx; }

.slot-head { display: flex; justify-content: space-between; align-items: center; min-height: 48rpx; }
.slot-name { font-size: 30rpx; color: var(--text); letter-spacing: 1rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-right: 12rpx; }
.days { display: flex; align-items: center; flex-shrink: 0; font-size: 24rpx; line-height: 1.5; }
.days-ok { color: var(--green-d); }
.days-warn, .days-danger { padding: 2rpx 12rpx 2rpx 8rpx; margin: 2rpx; }
.days-warn {
  color: var(--orange-d); background: #ffe2b0;
  box-shadow: 0 -2rpx 0 0 var(--orange-d), 0 2rpx 0 0 var(--orange-d), -2rpx 0 0 0 var(--orange-d), 2rpx 0 0 0 var(--orange-d);
}
.days-danger {
  color: var(--red-d); background: var(--red-l);
  box-shadow: 0 -2rpx 0 0 var(--red-d), 0 2rpx 0 0 var(--red-d), -2rpx 0 0 0 var(--red-d), 2rpx 0 0 0 var(--red-d);
}
.days-icon { width: 32rpx; height: 32rpx; margin-right: 8rpx; }
.days-num { font-size: 24rpx; }
.days-unit { margin-left: 6rpx; }
/* one warning shake, after the row has slid in */
.days.shake-late { animation-delay: 0.45s; }

.slot-meta { display: flex; justify-content: space-between; align-items: center; margin: 6rpx 0 10rpx; }
.slot-amount { display: flex; align-items: center; min-width: 0; font-size: 24rpx; color: var(--text-2); white-space: nowrap; }
.slot-amount.need { color: var(--orange-d); }
.est-badge {
  margin-left: 12rpx; padding: 0 8rpx; font-size: 20rpx; line-height: 1.5; color: var(--orange-d); background: #ffe2b0;
  box-shadow: 0 -2rpx 0 0 var(--orange-d), 0 2rpx 0 0 var(--orange-d), -2rpx 0 0 0 var(--orange-d), 2rpx 0 0 0 var(--orange-d);
}
.slot-exp { flex-shrink: 0; margin-left: 12rpx; font-size: 22rpx; color: var(--text-3); }

.empty-bag { display: flex; flex-direction: column; align-items: center; padding: 40rpx 28rpx; font-size: 26rpx; color: var(--text-3); }
.empty-icon { width: 64rpx; height: 64rpx; margin-bottom: 16rpx; }
.notice { padding-top: 8rpx; }

/* ---------------------------------------------------------------- add sheet */
.sheet-icon { width: 40rpx; height: 40rpx; margin-right: 12rpx; }
.sheet-close {
  width: 56rpx; height: 56rpx; margin: 4rpx; display: flex; align-items: center; justify-content: center; background: var(--paper);
  box-shadow: 0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink),
    inset -4rpx -4rpx 0 0 var(--paper-3), 4rpx 6rpx 0 0 var(--shadow);
}
.sheet-close image { width: 32rpx; height: 32rpx; }
.sugg { padding: 12rpx 0 4rpx; }
.next-icon { width: 32rpx; height: 32rpx; margin-left: 12rpx; }
.btn .btn-icon { width: 32rpx; height: 32rpx; vertical-align: -6rpx; margin-right: 12rpx; }
