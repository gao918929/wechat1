<px-nav title="冰箱" subtitle="{{group.name}} · {{stats.total}} 种食材" large>
  <view slot="right" class="nav-add" wx:if="{{isAdmin}}" bindtap="toggleAdd" hover-class="px-pressed">
    <image class="nav-add-img" src="/assets/px/plus.svg" />
  </view>
</px-nav>

<view class="container">
  <!-- bag status window: fridge buddy + three counters -->
  <view class="card bag anim-slide">
    <view class="bag-top">
      <view class="bag-hero">
        <px-sprite name="sprite-inventory" frames="2" size="112" duration="1200" />
      </view>
      <view class="bag-stats">
        <view class="bag-stat">
          <view class="px-num bag-num">{{stats.total}}</view>
          <view class="bag-lbl">种食材</view>
        </view>
        <view class="bag-stat sep">
          <view class="px-num bag-num {{stats.urgent ? 'is-warn' : ''}}">{{stats.urgent}}</view>
          <view class="bag-lbl">需尽快处理</view>
        </view>
        <view class="bag-stat sep">
          <view class="px-num bag-num {{stats.needsWeight ? 'is-blue' : ''}}">{{stats.needsWeight}}</view>
          <view class="bag-lbl">待补重量</view>
        </view>
      </view>
    </view>
    <view class="bag-alert" wx:if="{{alertNames}}">
      <image class="bag-alert-icon" src="/assets/px/clock.svg" />
      <text class="bag-alert-key">先吃掉</text>
      <text class="bag-alert-names">{{alertNames}}</text>
    </view>
    <view class="bag-alert ok" wx:elif="{{items.length}}">
      <image class="bag-alert-icon" src="/assets/px/check.svg" />
      <text class="bag-alert-names">全部新鲜，没有临期食材</text>
    </view>
  </view>

  <!-- two big entry tiles -->
  <view class="action-row">
    <view class="action-wrap anim-slide d1">
      <view class="action-card" bindtap="photo" hover-class="px-pressed">
        <view class="mini-icon i-blue"><image src="/assets/px/camera.svg" /></view>
        <view class="grow">
          <view class="action-name">拍照识别</view>
          <view class="action-sub">参照物估重</view>
        </view>
      </view>
    </view>
    <view class="action-wrap anim-slide d2">
      <view class="action-card" bindtap="receipt" hover-class="px-pressed">
        <view class="mini-icon i-orange"><image src="/assets/px/receipt.svg" /></view>
        <view class="grow">
          <view class="action-name">小票入库</view>
          <view class="action-sub">顺便记账</view>
        </view>
      </view>
    </view>
  </view>

  <!-- say-a-sentence box + RPG reply -->
  <view class="card ask anim-slide d3">
    <view class="ask-head">
      <image class="ask-icon" src="/assets/px/magic.svg" />
      <text>说一句，冰箱宝宝帮你记</text>
    </view>
    <view class="chat-bar">
      <input class="input" placeholder="冰箱里还有两个鸡蛋和半颗白菜" value="{{chatText}}" bindinput="onChatInput" confirm-type="send" bindconfirm="sendChat" />
      <view class="send" bindtap="sendChat" hover-class="px-pressed"><image src="/assets/px/send.svg" /></view>
    </view>
    <view class="px-dialog reply anim-slide-x" wx:if="{{chatReply}}">
      <view class="reply-who">
        <image class="reply-icon" src="/assets/px/{{chatOk ? 'check' : 'warn'}}.svg" />
        <text>冰箱宝宝</text>
      </view>
      <px-typewriter text="{{chatReply}}" speed="30" step="2" />
    </view>
    <view class="member-hint" wx:if="{{!isAdmin}}">你是成员：可以标记消耗（如“今天用了两个鸡蛋”）；新增或修改库存需要管理员。</view>
  </view>

  <view class="section-title"><text>食材背包</text><text class="muted">按到期先后</text></view>

  <view wx:if="{{!items.length}}" class="card empty-bag">
    <image class="empty-icon" src="/assets/px/tab-fridge-off.svg" />
    <view>冰箱空空，拍张照或说一句话来录入</view>
  </view>

  <view wx:for="{{items}}" wx:key="id" class="slot-wrap anim-slide {{index < 6 ? 'd' + (index + 1) : ''}}">
    <view class="slot {{item.urgent ? 'slot-' + item.daysTone : ''}}" bindtap="itemActions" data-index="{{index}}" hover-class="px-pressed">
      <view class="slot-cell">
        <image wx:if="{{item.icon}}" class="slot-img" src="/assets/px/{{item.icon}}.svg" />
        <view wx:else class="avatar slot-avatar c-{{item.cat}}">{{item.initial}}</view>
      </view>
      <view class="grow">
        <view class="slot-head">
          <text class="slot-name">{{item.name}}</text>
          <view class="days days-{{item.daysTone}} {{item.urgent ? 'anim-shake shake-late' : ''}}">
            <image wx:if="{{item.urgent}}" class="days-icon" src="/assets/px/warn.svg" />
            <block wx:if="{{item.daysNum}}"><text class="px-num days-num">{{item.daysNum}}</text><text class="days-unit">天</text></block>
            <text wx:else>{{item.daysText}}</text>
          </view>
        </view>
        <view class="slot-meta">
          <view class="slot-amount {{item.needs_weight ? 'need' : ''}}">
            <text>{{item.amount}}</text>
            <text class="est-badge" wx:if="{{item.isEst}}">估算</text>
          </view>
          <text class="slot-exp">{{item.expShort}} 到期</text>
        </view>
        <px-meter value="{{item.meterVal}}" segments="8" color="{{item.meterTone}}" height="20" />
      </view>
    </view>
  </view>

  <view class="notice">保质期按食材类别计算（叶菜 2–3 天、根茎 2–4 周…）；外观不新鲜优先于时间判断。</view>
</view>

<view class="mask" wx:if="{{showAdd}}" bindtap="toggleAdd">
  <view class="sheet" catchtap="">
    <view class="card-title">
      <view class="row"><image class="sheet-icon" src="/assets/px/plus.svg" /><text>手动添加</text></view>
      <view class="sheet-close" bindtap="toggleAdd" hover-class="px-pressed"><image class="sheet-close-img" src="/assets/px/cross.svg" /></view>
    </view>
    <view class="field"><text class="label">食材</text><input class="input" value="{{form.name}}" data-key="name" bindinput="onForm" placeholder="如 鸡胸肉" /></view>
    <view class="row wrap sugg" wx:if="{{suggestions.length}}">
      <text class="tag gray" wx:for="{{suggestions}}" wx:key="*this" data-name="{{item}}" bindtap="pickSuggestion" hover-class="px-pressed">{{item}}</text>
    </view>
    <view class="field"><text class="label">数量（个）</text><input class="input" type="digit" value="{{form.quantity}}" data-key="quantity" bindinput="onForm" /></view>
    <view class="field"><text class="label">重量（克）</text><input class="input" type="digit" value="{{form.weight_g}}" data-key="weight_g" bindinput="onForm" /></view>
    <picker mode="date" value="{{form.purchase_date}}" data-key="purchase_date" bindchange="onForm">
      <view class="field"><text class="label">购买日期</text><text class="grow">{{form.purchase_date || '默认今天'}}</text><image class="next-icon" src="/assets/px/ui-next.svg" /></view>
    </picker>
    <button class="btn mt" bindtap="submitAdd" hover-class="px-pressed"><image class="btn-icon" src="/assets/px/tab-fridge.svg" />放进冰箱</button>
  </view>
</view>
