<px-nav title="数字孪生" back />
<view class="container">
  <view class="tabs">
    <view class="tab {{view === 'me' ? 'active' : ''}}" hover-class="px-pressed" bindtap="setView" data-v="me">
      <image class="tab-icon" src="/assets/px/{{view === 'me' ? 'tab-me' : 'tab-me-off'}}.svg" />个人孪生
    </view>
    <view class="tab {{view === 'group' ? 'active' : ''}}" hover-class="px-pressed" bindtap="setView" data-v="group">
      <image class="tab-icon" src="/assets/px/users.svg" />小组孪生
    </view>
  </view>

  <view class="card err anim-pop" wx:if="{{view === 'group' && groupError}}">
    <image class="err-icon" src="/assets/px/warn.svg" />
    <text class="err-text">{{groupError}}</text>
  </view>

  <block wx:if="{{vm && (view === 'me' || groupTwin)}}">
    <!-- memory dex: status window -->
    <view class="card hero dex anim-slide">
      <view class="win-tab"><image class="win-tab-icon" src="/assets/px/twin.svg" />记忆图鉴</view>
      <view class="dex-head">
        <view class="dex-portrait"><image class="anim-bob" src="/assets/px/twin.svg" /></view>
        <view class="grow">
          <view class="dex-kicker">{{view === 'me' ? '个人孪生' : '小组孪生'}}<text class="ver px-num">V{{view === 'me' ? twin.version : groupTwin.version}}</text></view>
          <view class="dex-learn"><text class="px-num dex-num">{{vm.feedback}}</text><text class="dex-unit">条反馈已学习</text></view>
        </view>
      </view>

      <view class="dex-stats">
        <view class="ds"><view class="px-num ds-num good">{{vm.favor.length}}</view><view class="ds-lbl">偏爱</view></view>
        <view class="ds sep"><view class="px-num ds-num bad">{{vm.avoid.length}}</view><view class="ds-lbl">不爱</view></view>
        <view class="ds sep"><view class="px-num ds-num warn">{{vm.subs.length}}</view><view class="ds-lbl">替换</view></view>
        <view class="ds sep"><view class="px-num ds-num info">{{vm.calibration.length}}</view><view class="ds-lbl">校准</view></view>
      </view>

      <view class="dex-vis">
        <image class="dex-vis-icon" src="/assets/px/{{view === 'me' ? 'shield' : 'users'}}.svg" />
        <text class="grow">{{view === 'me' ? twin.visibility : '可见范围：' + groupTwin.visibility}} · 每周自动更新一次</text>
      </view>
      <button class="btn ghost small dex-btn" wx:if="{{view === 'me'}}" hover-class="px-pressed" bindtap="refresh">
        <image class="btn-icon" src="/assets/px/loop.svg" />立即按最新反馈更新
      </button>
    </view>

    <!-- group: member union / intersection -->
    <block wx:if="{{view === 'group'}}">
      <view class="section-title"><text>成员画像</text><text class="link">并集 / 交集</text></view>
      <view class="card entries anim-slide d1">
        <view class="entry">
          <view class="mini-icon i-orange"><image src="/assets/px/chili.svg" /></view>
          <view class="grow">
            <view class="entry-t">全员忌口并集</view>
            <view class="entry-v {{vm.unionAvoid ? '' : 'none'}}">{{vm.unionAvoid || '无'}}</view>
          </view>
        </view>
        <view class="entry">
          <view class="mini-icon i-red"><image src="/assets/px/shield.svg" /></view>
          <view class="grow">
            <view class="entry-t">全员过敏原并集</view>
            <view class="entry-v {{vm.unionAllergens ? '' : 'none'}}">{{vm.unionAllergens || '无'}}</view>
          </view>
        </view>
        <view class="entry" wx:if="{{vm.budget}}">
          <view class="mini-icon i-yellow"><image src="/assets/px/coin.svg" /></view>
          <view class="grow">
            <view class="entry-t">消费习惯</view>
            <view class="entry-v">周均支出 <text class="px-num money">¥{{vm.budget.avg_weekly_spend}}</text> · 常去 {{vm.budget.channels.length ? vm.budget.channels[0] : '—'}}</view>
          </view>
        </view>
      </view>
      <view class="px-dialog note anim-slide-x" wx:if="{{groupTwin.note}}">
        <view class="note-plate">孪生小结</view>
        <px-typewriter text="{{groupTwin.note}}" speed="30" step="2" />
      </view>
    </block>

    <!-- taste dex -->
    <view class="section-title"><text>口味图鉴</text></view>
    <view class="card pages anim-slide d2">
      <view class="pg">
        <view class="pg-head"><image class="pg-icon" src="/assets/px/heart.svg" /><text class="grow">偏爱的菜</text><text class="px-num pg-count">{{vm.favor.length}}</text></view>
        <view class="badges">
          <view wx:for="{{vm.favor}}" wx:key="name" class="badge good">
            <image wx:if="{{index === 0}}" class="badge-star" src="/assets/px/star.svg" />
            <text>{{item.name}}</text><text class="px-num sc">{{item.scoreText}}</text>
          </view>
          <text wx:if="{{!vm.favor.length}}" class="none">暂无</text>
        </view>
      </view>

      <view class="pg">
        <view class="pg-head"><image class="pg-icon" src="/assets/px/cross.svg" /><text class="grow">不太喜欢</text><text class="px-num pg-count">{{vm.avoid.length}}</text></view>
        <view class="badges">
          <view wx:for="{{vm.avoid}}" wx:key="name" class="badge bad"><text>{{item.name}}</text><text class="px-num sc">{{item.scoreText}}</text></view>
          <text wx:if="{{!vm.avoid.length}}" class="none">暂无</text>
        </view>
      </view>

      <view class="pg" wx:if="{{vm.ingredients.length}}">
        <view class="pg-head"><image class="pg-icon" src="/assets/px/leaf.svg" /><text class="grow">食材倾向</text><text class="px-num pg-count">{{vm.ingredients.length}}</text></view>
        <view class="badges">
          <view wx:for="{{vm.ingredients}}" wx:key="name" class="badge {{item.score > 0 ? 'good' : 'plain'}}"><text>{{item.name}}</text><text class="px-num sc">{{item.scoreText}}</text></view>
        </view>
      </view>

      <view class="pg" wx:if="{{vm.subs.length}}">
        <view class="pg-head"><image class="pg-icon" src="/assets/px/loop.svg" /><text class="grow">替换习惯</text><text class="px-num pg-count">{{vm.subs.length}}</text></view>
        <view class="badges">
          <view wx:for="{{vm.subs}}" wx:key="from" class="badge swap">
            <text>{{item.from}}</text><image class="swap-arrow" src="/assets/px/ui-next.svg" /><text>{{item.to}}</text><text class="px-num sc">×{{item.count}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- habits & calibration -->
    <view class="section-title"><text>习惯与校准</text></view>
    <view class="card entries anim-slide d3">
      <view class="entry" wx:if="{{vm.choices.length}}">
        <view class="mini-icon i-purple"><image src="/assets/px/magic.svg" /></view>
        <view class="grow">
          <view class="entry-t">方案选择</view>
          <view class="badges"><view wx:for="{{vm.choices}}" wx:key="name" class="badge plain"><text>{{item.name}}</text><text class="px-num sc">×{{item.n}}</text></view></view>
        </view>
      </view>
      <view class="entry" wx:if="{{vm.price}}">
        <view class="mini-icon i-yellow"><image src="/assets/px/coin.svg" /></view>
        <view class="grow"><view class="entry-t">消费习惯</view><view class="entry-v">{{vm.price}}</view></view>
      </view>
      <view class="entry" wx:if="{{vm.recent}}">
        <view class="mini-icon i-blue"><image src="/assets/px/meal.svg" /></view>
        <view class="grow"><view class="entry-t">最近吃过</view><view class="entry-v">{{vm.recent}}</view></view>
      </view>
      <view class="entry" wx:if="{{vm.calibration.length}}">
        <view class="mini-icon i-teal"><image src="/assets/px/scale.svg" /></view>
        <view class="grow">
          <view class="entry-t">估重校准</view>
          <view class="badges"><view wx:for="{{vm.calibration}}" wx:key="name" class="badge info"><text>{{item.name}}</text><text class="px-num sc">×{{item.factorText}}</text></view></view>
        </view>
      </view>
      <view class="entry hint" wx:if="{{!vm.choices.length && !vm.calibration.length}}">
        <view class="mini-icon"><image src="/assets/px/leaf.svg" /></view>
        <text class="grow hint-text">使用越多，这里记住的越多。</text>
      </view>
    </view>

    <!-- manual edits (me only) -->
    <block wx:if="{{view === 'me'}}">
      <view class="section-title"><text>手动调整</text><text class="link">仅本人可见</text></view>
      <view class="card manual anim-slide d4">
        <view class="field">
          <view class="label lbl"><image class="lbl-icon" src="/assets/px/heart.svg" /><text>喜欢</text></view>
          <input class="input" value="{{likes}}" data-k="likes" bindinput="onInput" placeholder="如 牛肉、西兰花" />
        </view>
        <view class="field">
          <view class="label lbl"><image class="lbl-icon" src="/assets/px/cross.svg" /><text>不喜欢</text></view>
          <input class="input" value="{{dislikes}}" data-k="dislikes" bindinput="onInput" placeholder="如 茄子" />
        </view>
        <view class="field">
          <view class="label lbl"><image class="lbl-icon" src="/assets/px/receipt.svg" /><text>备注</text></view>
          <input class="input" value="{{notes}}" data-k="notes" bindinput="onInput" placeholder="如 喜欢清淡、少油" />
        </view>
        <button class="btn save" hover-class="px-pressed" bindtap="save">保存</button>
      </view>
    </block>
  </block>
</view>
