<glass-nav title="{{title}}" subtitle="{{dateText}}" large>
  <view slot="right" class="home-avatar" bindtap="go" data-url="/pages/profile/profile">
    <view class="avatar round">{{initial}}</view>
    <view class="badge" wx:if="{{unread}}">{{unread}}</view>
  </view>
</glass-nav>

<view class="container">
  <picker range="{{groups}}" range-key="name" value="{{groupIndex}}" bindchange="onGroupChange">
    <view class="group-chip">
      <view class="live-dot {{llmOnline ? '' : 'off'}}"></view>
      <text class="bold">{{group.name}}</text>
      <text class="muted">· {{group.members}} 人 · {{llmOnline ? 'DeepSeek 在线' : '离线规则引擎'}}</text>
      <text class="chevron">⌄</text>
    </view>
  </picker>

  <!-- today: energy ring + macros -->
  <view class="card hero" bindtap="go" data-url="/pages/nutrition/nutrition">
    <view class="row">
      <view class="ring-wrap">
        <view class="ring {{today.over ? 'over' : ''}}" style="--p:{{today.pct || 0}}"></view>
        <view class="ring-center">
          <view class="big">{{today.kcal || 0}}</view>
          <view class="unit">/ {{today.target || '—'}} kcal</view>
        </view>
      </view>
      <view class="grow" style="margin-left:36rpx">
        <view class="muted">今日能量</view>
        <view class="today-left">{{today.over ? '已超出目标' : '还可摄入 ' + (today.left || 0)}}<text class="unit-inline" wx:if="{{!today.over}}"> kcal</text></view>
        <view wx:for="{{today.macros}}" wx:key="name" class="macro">
          <view class="between"><text class="small">{{item.name}}</text><text class="muted">{{item.v}}/{{item.t}}g</text></view>
          <view class="bar thin"><view class="fill {{item.cls}}" style="width:{{item.pct}}%"></view></view>
        </view>
      </view>
    </view>
  </view>

  <!-- quick actions -->
  <view class="card">
    <view class="grid">
      <view class="grid-item" bindtap="recognize" data-kind="ingredients"><view class="icon"><image src="/assets/icons/camera-w.svg" /></view>拍冰箱</view>
      <view class="grid-item" bindtap="recognize" data-kind="receipt"><view class="icon i-orange"><image src="/assets/icons/receipt-w.svg" /></view>小票记账</view>
      <view class="grid-item" bindtap="recognize" data-kind="meal"><view class="icon i-pink"><image src="/assets/icons/utensils-w.svg" /></view>餐后复盘</view>
      <view class="grid-item" bindtap="go" data-url="/pages/planner/planner"><view class="icon i-purple"><image src="/assets/icons/sparkles-w.svg" /></view>AI 周计划</view>
      <view class="grid-item" bindtap="openShopping"><view class="icon i-blue"><image src="/assets/icons/cart-w.svg" /></view>购物清单</view>
      <view class="grid-item" bindtap="go" data-url="/pages/nutrition/nutrition"><view class="icon i-teal"><image src="/assets/icons/chart-w.svg" /></view>营养分析</view>
    </view>
  </view>

  <!-- near-expiry -->
  <view class="section-title"><text>临期提醒</text><text class="link" bindtap="go" data-url="/pages/inventory/inventory">冰箱 ›</text></view>
  <scroll-view scroll-x class="chips" enhanced show-scrollbar="{{false}}" wx:if="{{alerts.length}}">
    <view wx:for="{{alerts}}" wx:key="id" class="chip">
      <view class="dot {{item.level === 'near_expiry' ? 'warn' : 'danger'}}"></view>
      <text class="chip-main">{{item.name}}</text>
      <text class="chip-sub">{{item.level !== 'near_expiry' ? item.label : item.days_left > 0 ? '剩 ' + item.days_left + ' 天' : '今天到期'}}</text>
    </view>
  </scroll-view>
  <view class="card empty-card" wx:else>
    <view class="mini-icon"><image src="/assets/icons/leaf-w.svg" /></view>
    <view class="grow"><view class="bold">冰箱状态良好</view><view class="muted">没有临期或不新鲜的食材</view></view>
  </view>

  <!-- latest plan -->
  <view class="section-title"><text>本周计划</text><text class="link" bindtap="go" data-url="/pages/planner/planner">全部 ›</text></view>
  <view class="card feature" bindtap="openPlan">
    <block wx:if="{{latestPlan && latestPlan.summary}}">
      <view class="between">
        <text class="tag glass">{{latestPlan.summary.title}}</text>
        <text class="muted">#{{latestPlan.id}}</text>
      </view>
      <view class="plan-quote ellipsis">“{{latestPlan.instruction || '按小组设置生成'}}”</view>
      <view class="row mt">
        <view class="stat"><view class="num">¥{{latestPlan.summary.total_cost}}</view><view class="lbl">预计采购</view></view>
        <view class="stat"><view class="num">¥{{latestPlan.summary.per_person_cost}}</view><view class="lbl">人均</view></view>
        <view class="stat"><view class="num">{{latestPlan.days}}天</view><view class="lbl">{{latestPlan.summary.within_budget === false ? '超预算' : '预算内'}}</view></view>
      </view>
    </block>
    <block wx:elif="{{latestPlan}}">
      <view class="bold" style="color:#fff">{{latestPlan.status === 'failed' ? '上次生成失败' : '四个智能体正在规划…'}}</view>
      <view class="muted mt">点击查看进度</view>
    </block>
    <block wx:else>
      <view class="row">
        <image src="/assets/icons/sparkles-w.svg" style="width:56rpx;height:56rpx;margin-right:20rpx" />
        <view class="grow"><view class="bold" style="color:#fff;font-size:32rpx">一句话生成一周菜单</view><view class="muted">库存、预算、健康、口味，一次兼顾</view></view>
        <text style="font-size:40rpx">›</text>
      </view>
    </block>
  </view>
</view>
