<view class="container">
  <view class="card">
    <view class="between">
      <view>
        <view class="bold" style="font-size:36rpx">你好，{{user.nickname || '朋友'}}</view>
        <view class="muted mt">AI 建议，你来决定 · 越用越懂你</view>
      </view>
      <view class="tag {{llmOnline ? '' : 'gray'}}">{{llmOnline ? 'DeepSeek 在线' : '离线规则引擎'}}</view>
    </view>
    <picker range="{{groups}}" range-key="name" value="{{groupIndex}}" bindchange="onGroupChange">
      <view class="between mt input">
        <text>当前：{{group.name}}（{{group.members}}人）</text>
        <text class="muted">切换 ▾</text>
      </view>
    </picker>
  </view>

  <view class="card">
    <view class="grid">
      <view class="grid-item" bindtap="recognize" data-kind="ingredients"><view class="icon">📷</view><view class="small">拍冰箱</view></view>
      <view class="grid-item" bindtap="recognize" data-kind="receipt"><view class="icon">🧾</view><view class="small">拍小票记账</view></view>
      <view class="grid-item" bindtap="recognize" data-kind="meal"><view class="icon">🍽</view><view class="small">餐后复盘</view></view>
      <view class="grid-item" bindtap="go" data-url="/pages/planner/planner"><view class="icon">🤖</view><view class="small">生成周计划</view></view>
      <view class="grid-item" bindtap="openShopping"><view class="icon">🛒</view><view class="small">购物清单</view></view>
      <view class="grid-item" bindtap="go" data-url="/pages/nutrition/nutrition"><view class="icon">📊</view><view class="small">营养分析</view></view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">
      <text>临期提醒</text>
      <text class="muted" bindtap="go" data-url="/pages/inventory/inventory">查看冰箱 ›</text>
    </view>
    <view wx:if="{{!alerts.length}}" class="muted">暂无临期或不新鲜的食材 👍</view>
    <view wx:for="{{alerts}}" wx:key="id" class="between list-item">
      <text>{{item.name}}</text>
      <view>
        <text class="tag {{item.level === 'near_expiry' ? 'warn' : 'danger'}}">{{item.label}}</text>
        <text class="muted" wx:if="{{item.days_left >= 0}}">剩 {{item.days_left}} 天</text>
      </view>
    </view>
    <view class="notice" wx:if="{{alerts.length}}">生成计划时，库存优先智能体会把临期食材安排在最前面。</view>
  </view>

  <view class="card" bindtap="openPlan">
    <view class="card-title">
      <text>最近的计划</text>
      <text class="muted" wx:if="{{latestPlan}}">查看 ›</text>
    </view>
    <view wx:if="{{!latestPlan}}" class="muted">还没有计划，去“计划”页用一句话生成吧。</view>
    <block wx:else>
      <view class="small">{{latestPlan.instruction || '按小组设置生成'}}</view>
      <view class="mt" wx:if="{{latestPlan.summary}}">
        <text class="tag">{{latestPlan.summary.title}}</text>
        <text class="tag gray">¥{{latestPlan.summary.total_cost}}</text>
        <text class="tag gray">人均 ¥{{latestPlan.summary.per_person_cost}}</text>
      </view>
      <view class="mt" wx:else><text class="tag warn">{{latestPlan.status === 'failed' ? '生成失败' : '生成中…'}}</text></view>
    </block>
  </view>

  <view class="card between" bindtap="go" data-url="/pages/notifications/notifications">
    <text>消息通知</text>
    <text class="tag {{unread ? 'warn' : 'gray'}}">{{unread}} 条未读</text>
  </view>
</view>
