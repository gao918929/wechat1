<px-nav title="购物清单" back />
<view class="container no-tab" wx:if="{{shopping}}">
  <!-- quest window: total (cart + coin), budget, progress -->
  <view class="card feature quest anim-slide">
    <view class="q-head">
      <view class="q-cart"><image src="/assets/px/cart.svg" /></view>
      <view class="grow">
        <view class="q-kicker">购物任务 · {{itemCount}} 项</view>
        <view class="q-title ellipsis">{{title}}</view>
      </view>
    </view>

    <view class="q-total-row">
      <image class="q-coin anim-coin" src="/assets/px/coin.svg" />
      <view class="px-num q-total {{totalCls}}">¥{{totalText}}</view>
      <text class="q-total-lbl">合计</text>
    </view>

    <view class="q-stats">
      <view class="q-stat">
        <view class="px-num q-num">¥{{perText}}</view>
        <view class="q-lbl">人均 · {{shopping.people}} 人</view>
      </view>
      <view class="q-stat sep">
        <view class="px-num q-num">{{shopping.budget_total ? '¥' + shopping.budget_total : '—'}}</view>
        <view class="q-lbl">{{shopping.budget_total ? '预算' : '未设预算'}}</view>
      </view>
      <view class="q-stat sep" wx:if="{{shopping.budget_total}}">
        <view class="px-num q-num {{shopping.over_budget ? 'over anim-shake' : ''}}">{{shopping.over_budget ? '¥' + overText : '¥' + leftText}}</view>
        <view class="q-lbl">{{shopping.over_budget ? '超预算' : '剩余'}}</view>
      </view>
    </view>

    <view class="q-progress">
      <view class="q-prow">
        <image class="q-picon" src="/assets/px/check.svg" />
        <text class="grow" wx:if="{{itemCount && doneCount === itemCount}}"><text class="q-clear anim-pop">全部买齐!</text></text>
        <text class="grow" wx:else>已买</text>
        <text class="px-num q-pnum">{{doneCount}}/{{itemCount}}</text>
      </view>
      <px-meter value="{{donePct}}" segments="{{itemCount > 40 ? 40 : itemCount}}" color="yellow" height="28" />
    </view>

    <view class="btn-row">
      <button class="btn ghost" hover-class="px-pressed" bindtap="copyText"><image class="btn-icon" src="/assets/px/receipt.svg" />复制清单</button>
      <button class="btn ghost" hover-class="px-pressed" bindtap="makeImage"><image class="btn-icon" src="/assets/px/camera.svg" />生成图片</button>
    </view>
  </view>
  <view class="notice">勾选会实时同步给小组所有人；库存已有的食材已自动扣除；标“参考价”的金额为估算。</view>

  <!-- one window per section -->
  <view wx:for="{{shopping.sections}}" wx:for-item="sec" wx:key="section" class="card sec {{index < 6 ? 'anim-slide d' + (index + 1) : ''}}">
    <view class="sec-bar cat-{{sec.section}}">
      <view class="sec-icon"><image src="/assets/px/{{sec.icon}}.svg" /></view>
      <text class="sec-name">{{sec.label}}</text>
      <image wx:if="{{secDone[sec.section] === sec.items.length}}" class="sec-done anim-pop" src="/assets/px/star.svg" />
      <text class="px-num sec-count">{{secDone[sec.section] || 0}}/{{sec.items.length}}</text>
    </view>
    <view class="sec-list">
      <view wx:for="{{sec.items}}" wx:key="name" class="it {{checked[item.name] ? 'done' : ''}}" hover-class="px-pressed-row" bindtap="toggle" data-name="{{item.name}}">
        <view class="check {{checked[item.name] ? 'on anim-pop' : ''}}"></view>
        <view class="it-cell">
          <image wx:if="{{item.icon}}" class="it-img" src="/assets/px/{{item.icon}}.svg" />
          <text wx:else class="it-initial">{{item.initial}}</text>
        </view>
        <view class="grow">
          <view class="it-name">{{item.name}}</view>
          <view class="it-qty">{{item.qty_text}}<text wx:if="{{item.have_g}}" class="it-have"> · 库存已有 {{item.have_g}}g</text></view>
        </view>
        <view class="it-price">
          <view class="px-num it-cost">¥{{item.costText}}</view>
          <text class="ptag {{item.price_estimated ? 'est' : 'hist'}}">{{item.price_estimated ? '参考价' : '历史价'}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="card extra" wx:if="{{shopping.pantry.length}}">
    <view class="extra-head">
      <image class="extra-icon" src="/assets/px/pot.svg" />
      <text class="grow">常备调料检查</text>
      <text class="tag gray">不计入预算</text>
    </view>
    <view class="extra-tags"><text wx:for="{{shopping.pantry}}" wx:key="name" class="tag gray">{{item.name}}</text></view>
  </view>
  <view class="card extra" wx:if="{{shopping.covered_by_inventory.length}}">
    <view class="extra-head">
      <image class="extra-icon" src="/assets/px/tab-fridge.svg" />
      <text class="grow">库存已够，无需购买</text>
    </view>
    <view class="extra-tags"><text wx:for="{{shopping.covered_by_inventory}}" wx:key="name" class="tag">{{item.name}}</text></view>
  </view>
  <canvas type="2d" id="shot" style="width:360px;height:{{canvasH}}px;position:fixed;left:-2000px;top:0"></canvas>
</view>
<view class="container no-tab loading" wx:else>
  <px-sprite name="sprite-pot" frames="4" size="128" duration="800" />
  <view class="loading-text">清单整理中…</view>
  <view class="px-loading loading-bar"></view>
</view>
