<glass-nav title="购物清单" back />
<view class="container" wx:if="{{shopping}}">
  <view class="card feature">
    <view class="muted">{{title}}</view>
    <view class="row mt">
      <view class="stat"><view class="num">¥{{totalText}}</view><view class="lbl">合计</view></view>
      <view class="stat"><view class="num">¥{{perText}}</view><view class="lbl">人均 · {{shopping.people}} 人</view></view>
      <view class="stat"><view class="num">{{shopping.budget_total ? '¥' + shopping.budget_total : '—'}}</view><view class="lbl">{{shopping.over_budget ? '超预算 ¥' + shopping.over_amount : '预算'}}</view></view>
    </view>
    <view class="btn-row">
      <button class="btn light" bindtap="copyText">复制清单</button>
      <button class="btn glass-btn" bindtap="makeImage">生成图片</button>
    </view>
  </view>
  <view class="notice">勾选会实时同步给小组所有人；库存已有的食材已自动扣除；标“参考价”的金额为估算。</view>

  <block wx:for="{{shopping.sections}}" wx:for-item="sec" wx:key="section">
  <view class="section-title"><text>{{sec.label}}</text><text class="muted">{{sec.items.length}} 项</text></view>
  <view class="card flush">
    <view wx:for="{{sec.items}}" wx:key="name" class="list-item between" bindtap="toggle" data-name="{{item.name}}">
      <view class="row grow">
        <view class="check {{checked[item.name] ? 'on' : ''}}"></view>
        <view>
          <view class="bold" style="{{checked[item.name] ? 'text-decoration:line-through;color:#aaa' : ''}}">{{item.name}}</view>
          <view class="muted">{{item.qty_text}}<text wx:if="{{item.have_g}}"> · 库存已有 {{item.have_g}}g</text></view>
        </view>
      </view>
      <view class="center">
        <view>¥{{item.cost}}</view>
        <view class="muted" wx:if="{{item.price_estimated}}">参考价</view>
        <view class="muted" wx:else style="color:var(--accent)">历史价</view>
      </view>
    </view>
  </view>
  </block>

  <view class="card" wx:if="{{shopping.pantry.length}}">
    <view class="bold">常备调料检查（不计入预算）</view>
    <view class="small mt">{{pantryText}}</view>
  </view>
  <view class="card" wx:if="{{shopping.covered_by_inventory.length}}">
    <view class="bold">库存已够，无需购买</view>
    <view class="small mt">{{coveredText}}</view>
  </view>
  <canvas type="2d" id="shot" style="width:360px;height:{{canvasH}}px;position:fixed;left:-2000px;top:0"></canvas>
</view>
