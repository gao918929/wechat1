.score-level { font-size: 40rpx; font-weight: 800; letter-spacing: -0.5rpx; margin-bottom: 6rpx; }
.chart { position: relative; display: flex; align-items: flex-end; height: 400rpx; padding-top: 20rpx; }
.target-line { position: absolute; left: 0; right: 0; border-top: 2rpx dashed rgba(29, 158, 108, 0.45); }
.col { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; }
.col-val { font-size: 18rpx; color: var(--text-3); margin-bottom: 8rpx; }
.col-bar { width: 36rpx; border-radius: 18rpx; background: linear-gradient(180deg, #5ad493, #13a3a0); box-shadow: 0 8rpx 16rpx rgba(29, 158, 108, 0.22); }
.col-bar.over { background: linear-gradient(180deg, #ffcb6b, #f08a24); box-shadow: 0 8rpx 16rpx rgba(240, 138, 36, 0.22); }
.col-bar.empty { background: var(--fill); box-shadow: none; }
.col-day { font-size: 24rpx; font-weight: 600; margin-top: 12rpx; }
.col-date { font-size: 18rpx; color: var(--text-3); }
.macro-row { padding: 14rpx 0; }
.macro-row .bar { margin-top: 10rpx; }
.micro-grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.micro { width: calc(50% - 12rpx); box-sizing: border-box; margin-bottom: 24rpx; padding: 28rpx; border-radius: 36rpx; background: rgba(255, 255, 255, 0.62); border: 1rpx solid rgba(255, 255, 255, 0.75); box-shadow: 0 14rpx 36rpx rgba(17, 40, 30, 0.06); }
.micro-v { font-size: 48rpx; font-weight: 800; letter-spacing: -1rpx; background: linear-gradient(135deg, #1d9e6c, #13a3a0); -webkit-background-clip: text; background-clip: text; color: transparent; }
.micro-u { font-size: 24rpx; }
