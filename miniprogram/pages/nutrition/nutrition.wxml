<glass-nav title="营养分析" back />
<view class="container">
  <view class="tabs">
    <view class="tab {{view === 'me' ? 'active' : ''}}" bindtap="setView" data-v="me">个人</view>
    <view class="tab {{view === 'group' ? 'active' : ''}}" bindtap="setView" data-v="group">小组整体</view>
  </view>
  <view class="row mb">
    <text class="tag {{days === 7 ? '' : 'gray'}}" bindtap="setDays" data-d="7">近 7 天</text>
    <text class="tag {{days === 30 ? '' : 'gray'}}" bindtap="setDays" data-d="30">近 30 天</text>
  </view>

  <block wx:if="{{view === 'me' && report}}">
    <view class="card hero">
      <view class="row">
        <view class="ring-wrap">
          <view class="ring" style="--p:{{report.score || 0}}"></view>
          <view class="ring-center"><view class="big">{{report.scoreText}}</view><view class="unit">健康评分</view></view>
        </view>
        <view class="grow" style="margin-left:36rpx">
          <view class="score-level">{{report.scoreLevel}}</view>
          <view class="muted">已记录 {{report.logged_days}} 天 · 目标 {{report.target.kcal}} kcal/天</view>
          <view class="row wrap mt" wx:if="{{report.reasons.length}}"><text class="tag warn" wx:for="{{report.reasons}}" wx:key="*this">{{item}}</text></view>
          <view class="muted mt" wx:if="{{!report.logged_days}}">在计划里点“吃了”，或拍照复盘一餐</view>
        </view>
      </view>
    </view>

    <view class="section-title"><text>能量趋势</text><text class="muted">虚线为目标</text></view>
    <view class="card">
      <view class="chart">
        <view class="target-line" style="bottom:{{report.targetLine + 74}}rpx"></view>
        <view wx:for="{{bars}}" wx:key="date" class="col">
          <view class="col-val">{{item.kcal || ''}}</view>
          <view class="col-bar {{item.over ? 'over' : ''}} {{item.empty ? 'empty' : ''}}" style="height:{{item.h}}rpx"></view>
          <view class="col-day">{{item.week}}</view>
          <view class="col-date">{{item.date}}</view>
        </view>
      </view>
    </view>

    <view class="section-title"><text>日均摄入</text><text class="muted">对比目标</text></view>
    <view class="card">
      <view wx:for="{{report.macros}}" wx:key="name" class="macro-row">
        <view class="between"><text class="bold">{{item.name}}</text><text class="muted">{{item.v}} / {{item.t}} {{item.unit}}</text></view>
        <view class="bar"><view class="fill" style="width:{{item.pct}}%"></view></view>
      </view>
    </view>

    <view class="section-title"><text>维生素与矿物质</text><text class="muted">估算</text></view>
    <view class="micro-grid">
      <view wx:for="{{report.micro}}" wx:key="name" class="micro">
        <view class="micro-v">{{item.v}}<text class="micro-u">{{item.unit}}</text></view>
        <view class="bold">{{item.name}}</view>
        <view class="muted">参考 {{item.ref}}{{item.unit}}</view>
      </view>
    </view>
    <view class="notice">数据来源：{{report.sources}}。{{report.disclaimer}}</view>
  </block>

  <block wx:if="{{view === 'group'}}">
    <view class="card">
      <view class="card-title">{{group.name}} · 日均</view>
      <view wx:for="{{members}}" wx:key="user_id" class="list-item">
        <view class="between"><text class="bold">{{item.nickname}}</text><text class="muted">{{item.meals}} 餐记录</text></view>
        <view class="between small mt"><text>能量 {{item.avg_kcal}} / {{item.target_kcal}} kcal</text><text>蛋白质 {{item.avg_protein}} / {{item.target_protein}} g</text></view>
        <view class="bar mt"><view class="fill" style="width:{{item.pct}}%"></view></view>
      </view>
    </view>
    <view class="notice">{{disclaimer}}</view>
  </block>
</view>
