/* The blurred element itself must be the fixed layer: a backdrop-filter nested inside a
   fixed wrapper only sees the wrapper's own layer and would not blur the page behind it. */
.tb {
  position: fixed; z-index: 95; left: 28rpx; right: 28rpx;
  bottom: calc(env(safe-area-inset-bottom) + 16rpx);
  display: flex; height: 120rpx; padding: 0 10rpx; align-items: center;
  border-radius: 60rpx;
  background: rgba(255, 255, 255, 0.62);
  -webkit-backdrop-filter: saturate(180%) blur(30px);
  backdrop-filter: saturate(180%) blur(30px);
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  box-shadow: 0 16rpx 48rpx rgba(31, 60, 45, 0.14), inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
}
.tb-item {
  flex: 1; height: 100rpx; display: flex; flex-direction: column; align-items: center; justify-content: center;
  border-radius: 50rpx; transition: background 0.2s;
}
.tb-item.on { background: rgba(29, 158, 108, 0.12); }
.tb-icon { width: 46rpx; height: 46rpx; }
.tb-text { font-size: 20rpx; margin-top: 4rpx; color: #8b918d; }
.tb-item.on .tb-text { color: #1d9e6c; font-weight: 600; }
