/* ==========================================================================
   MealAgent design system — "Fresh Glass"
   iOS-inspired: soft colour mesh (components/glass-nav) under frosted surfaces,
   one emerald→teal accent, restrained type scale, generous spacing.
   ========================================================================== */
page {
  --accent: #1d9e6c;
  --accent-2: #13a3a0;
  --accent-grad: linear-gradient(135deg, #2fc07e 0%, #1d9e6c 50%, #13a3a0 100%);
  --accent-tint: rgba(29, 158, 108, 0.12);
  --orange: #f08a24;
  --orange-tint: rgba(255, 149, 0, 0.14);
  --red: #e5484d;
  --red-tint: rgba(229, 72, 77, 0.12);
  --blue: #2f80ed;
  --indigo: #6b5cf6;
  --text: #111613;
  --text-2: #5f6661;
  --text-3: #979d99;
  --line: rgba(60, 60, 67, 0.10);
  --fill: rgba(120, 128, 122, 0.10);
  --glass: rgba(255, 255, 255, 0.62);
  --glass-border: rgba(255, 255, 255, 0.75);
  background: #f4f6f2;
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.45;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", "Helvetica Neue", sans-serif;
  -webkit-font-smoothing: antialiased;
}

.container { padding: 0 32rpx; padding-bottom: calc(env(safe-area-inset-bottom) + 210rpx); }

/* ---------------------------------------------------------------- surfaces */
.card {
  position: relative;
  background: var(--glass);
  -webkit-backdrop-filter: saturate(170%) blur(24px);
  backdrop-filter: saturate(170%) blur(24px);
  border: 1rpx solid var(--glass-border);
  border-radius: 40rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 2rpx 6rpx rgba(17, 22, 19, 0.03), 0 18rpx 48rpx rgba(17, 40, 30, 0.07);
}
.card.flush { padding: 8rpx 32rpx; }
.card.hero { background: linear-gradient(140deg, rgba(255, 255, 255, 0.80), rgba(255, 255, 255, 0.46)); }
/* tinted "feature" card: deep emerald glass with white text */
.card.feature {
  color: #fff; border-color: rgba(255, 255, 255, 0.28);
  background: linear-gradient(140deg, rgba(36, 178, 120, 0.92) 0%, rgba(22, 150, 130, 0.90) 55%, rgba(30, 128, 150, 0.90) 100%);
  box-shadow: 0 22rpx 50rpx rgba(23, 140, 110, 0.32), inset 0 1rpx 0 rgba(255, 255, 255, 0.35);
}
.card.feature .muted, .card.feature .lbl { color: rgba(255, 255, 255, 0.78); }
.card.feature .stat .num { background: none; color: #fff; -webkit-text-fill-color: #fff; }

.card-title { font-size: 34rpx; font-weight: 700; margin-bottom: 18rpx; display: flex; justify-content: space-between; align-items: center; }
.section-title {
  display: flex; justify-content: space-between; align-items: baseline;
  padding: 18rpx 12rpx 14rpx; font-size: 36rpx; font-weight: 700; letter-spacing: -0.3rpx;
}
.section-title .link { font-size: 26rpx; font-weight: 500; color: var(--accent); }
.large-title { font-size: 60rpx; font-weight: 800; letter-spacing: -1rpx; }

/* ---------------------------------------------------------------- helpers */
.row { display: flex; align-items: center; }
.between { display: flex; justify-content: space-between; align-items: center; }
.wrap { flex-wrap: wrap; }
.grow { flex: 1; min-width: 0; }
.muted { color: var(--text-3); font-size: 24rpx; }
.small { font-size: 26rpx; color: var(--text-2); }
.bold { font-weight: 600; color: var(--text); }
.mt { margin-top: 16rpx; }
.mb { margin-bottom: 16rpx; }
.ml { margin-left: 12rpx; }
.center { text-align: center; }
.ellipsis { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* ---------------------------------------------------------------- tags & chips */
.tag {
  display: inline-block; padding: 6rpx 18rpx; border-radius: 999rpx; font-size: 22rpx; font-weight: 600;
  background: var(--accent-tint); color: var(--accent); margin: 4rpx 10rpx 4rpx 0; line-height: 1.5;
}
.tag.warn { background: var(--orange-tint); color: var(--orange); }
.tag.danger { background: var(--red-tint); color: var(--red); }
.tag.gray { background: var(--fill); color: var(--text-2); }
.tag.glass { background: rgba(255, 255, 255, 0.22); color: #fff; }

.chips { white-space: nowrap; margin: 0 -32rpx 28rpx; padding: 0 32rpx; box-sizing: border-box; width: auto; }
.chip {
  display: inline-flex; align-items: center; margin-right: 16rpx; padding: 18rpx 26rpx; border-radius: 28rpx;
  background: var(--glass); border: 1rpx solid var(--glass-border);
  -webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px);
  box-shadow: 0 10rpx 28rpx rgba(17, 40, 30, 0.06); vertical-align: top;
}
.chip .dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: var(--accent); margin-right: 14rpx; }
.chip .dot.warn { background: var(--orange); }
.chip .dot.danger { background: var(--red); }
.chip-main { font-size: 28rpx; font-weight: 600; }
.chip-sub { font-size: 22rpx; color: var(--text-3); margin-left: 10rpx; }

/* ---------------------------------------------------------------- buttons */
.btn {
  background: var(--accent-grad); color: #fff; border-radius: 999rpx; font-size: 30rpx; font-weight: 600;
  padding: 24rpx 36rpx; text-align: center; letter-spacing: 0.5rpx;
  box-shadow: 0 14rpx 32rpx rgba(29, 158, 108, 0.30), inset 0 1rpx 0 rgba(255, 255, 255, 0.35);
}
/* secondary = iOS tinted button */
.btn.ghost, .btn.tinted { background: var(--accent-tint); color: var(--accent); box-shadow: none; }
.btn.light { background: rgba(255, 255, 255, 0.9); color: var(--accent); box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.10); }
.btn.warn { background: linear-gradient(135deg, #ffb547, #f08a24); box-shadow: 0 14rpx 32rpx rgba(240, 138, 36, 0.3); }
.btn.small { padding: 14rpx 28rpx; font-size: 26rpx; box-shadow: 0 8rpx 18rpx rgba(29, 158, 108, 0.24); }
.btn.ghost.small, .btn.tinted.small { box-shadow: none; }
.btn[disabled] { opacity: 0.45; }
button.btn { margin: 0; line-height: 1.4; }
button.btn::after { border: none; }
.btn-row { display: flex; gap: 18rpx; margin-top: 24rpx; }
.btn-row .btn { flex: 1; }
.btn-icon { width: 34rpx; height: 34rpx; vertical-align: -6rpx; margin-right: 10rpx; }

/* ---------------------------------------------------------------- inputs */
.input { background: var(--fill); border-radius: 24rpx; padding: 20rpx 26rpx; font-size: 28rpx; min-height: 44rpx; }
.textarea { background: var(--fill); border-radius: 28rpx; padding: 24rpx 28rpx; width: auto; min-height: 180rpx; font-size: 30rpx; line-height: 1.6; }
.field { display: flex; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid var(--line); min-height: 48rpx; }
.field:last-child { border-bottom: none; }
.field .label { width: 190rpx; color: var(--text); font-size: 28rpx; }
.field .input { flex: 1; }
/* inside grouped lists: iOS Settings style — no fill, right aligned */
.card.flush .field .input { background: transparent; text-align: right; padding: 0; color: var(--text-2); }
.chat-bar { display: flex; gap: 14rpx; align-items: center; }
.chat-bar .input { flex: 1; border-radius: 999rpx; padding-left: 32rpx; }
.send { width: 76rpx; height: 76rpx; border-radius: 50%; background: var(--accent-grad); display: flex; align-items: center; justify-content: center; box-shadow: 0 8rpx 18rpx rgba(29, 158, 108, 0.3); }
.send image { width: 36rpx; height: 36rpx; }

/* ---------------------------------------------------------------- lists */
.list-item { padding: 24rpx 0; border-bottom: 1rpx solid var(--line); }
.list-item:last-child { border-bottom: none; }
.chevron { color: var(--text-3); font-size: 32rpx; margin-left: 12rpx; }
.avatar {
  width: 80rpx; height: 80rpx; border-radius: 24rpx; flex-shrink: 0; margin-right: 22rpx;
  display: flex; align-items: center; justify-content: center; font-size: 32rpx; font-weight: 700; color: #fff;
  background: linear-gradient(145deg, #5bd99a, #1d9e6c);
}
.avatar.round { border-radius: 50%; }
.avatar.c-vegetables { background: linear-gradient(145deg, #7ee2a8, #2bb673); }
.avatar.c-meat_eggs { background: linear-gradient(145deg, #ffa3a3, #ef5b6a); }
.avatar.c-seafood { background: linear-gradient(145deg, #8fd0ff, #3b8ef0); }
.avatar.c-staples { background: linear-gradient(145deg, #ffd88a, #f2a33a); }
.avatar.c-soy_dairy { background: linear-gradient(145deg, #c7b8ff, #7b68ee); }
.avatar.c-seasonings { background: linear-gradient(145deg, #c9cfcb, #8e9691); }

/* ---------------------------------------------------------------- stats, bars, rings */
.stat { flex: 1; text-align: center; }
.stat .num {
  font-size: 46rpx; font-weight: 800; letter-spacing: -1rpx;
  background: linear-gradient(135deg, #1d9e6c, #13a3a0);
  -webkit-background-clip: text; background-clip: text; color: transparent;
}
.stat .lbl { font-size: 22rpx; color: var(--text-3); margin-top: 4rpx; }
.bar { height: 14rpx; background: var(--fill); border-radius: 999rpx; overflow: hidden; }
.bar.thin { height: 8rpx; }
.bar .fill { height: 100%; border-radius: 999rpx; background: linear-gradient(90deg, #2fc07e, #13a3a0); }
.bar .fill.warn { background: linear-gradient(90deg, #ffc94d, #f08a24); }
.bar .fill.danger { background: linear-gradient(90deg, #ff9f43, #e5484d); }
.bar .fill.blue { background: linear-gradient(90deg, #7cc4ff, #2f80ed); }
.bar .fill.indigo { background: linear-gradient(90deg, #b3a6ff, #6b5cf6); }

/* conic-gradient ring; set --p (0–100) inline */
.ring {
  position: relative; width: 200rpx; height: 200rpx; border-radius: 50%; flex-shrink: 0;
  background: conic-gradient(from -90deg, #2fc07e 0%, #13a3a0 calc(var(--p) * 1%), rgba(120, 128, 122, 0.13) calc(var(--p) * 1%));
  -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 26rpx), #000 calc(100% - 25rpx));
  mask: radial-gradient(farthest-side, transparent calc(100% - 26rpx), #000 calc(100% - 25rpx));
}
.ring.over { background: conic-gradient(from -90deg, #ffc94d 0%, #f08a24 100%); }
.ring-wrap { position: relative; width: 200rpx; height: 200rpx; flex-shrink: 0; }
.ring-center { position: absolute; left: 0; top: 0; right: 0; bottom: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.ring-center .big { font-size: 44rpx; font-weight: 800; letter-spacing: -1rpx; }
.ring-center .unit { font-size: 20rpx; color: var(--text-3); }

/* ---------------------------------------------------------------- app-icon tiles */
.grid { display: flex; flex-wrap: wrap; }
.grid-item { width: 33.33%; text-align: center; padding: 18rpx 0; font-size: 24rpx; color: var(--text-2); }
.grid-item .icon {
  width: 104rpx; height: 104rpx; border-radius: 30rpx; margin: 0 auto 14rpx;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(150deg, #5ad493, #1d9e6c);
  box-shadow: 0 12rpx 26rpx rgba(29, 158, 108, 0.28), inset 0 2rpx 0 rgba(255, 255, 255, 0.4);
}
.grid-item .icon image { width: 52rpx; height: 52rpx; }
.i-blue { background: linear-gradient(150deg, #7cc4ff, #2f80ed) !important; box-shadow: 0 12rpx 26rpx rgba(47, 128, 237, 0.28), inset 0 2rpx 0 rgba(255,255,255,0.4) !important; }
.i-orange { background: linear-gradient(150deg, #ffcb6b, #f08a24) !important; box-shadow: 0 12rpx 26rpx rgba(240, 138, 36, 0.28), inset 0 2rpx 0 rgba(255,255,255,0.4) !important; }
.i-purple { background: linear-gradient(150deg, #b9a8ff, #6b5cf6) !important; box-shadow: 0 12rpx 26rpx rgba(107, 92, 246, 0.28), inset 0 2rpx 0 rgba(255,255,255,0.4) !important; }
.i-pink { background: linear-gradient(150deg, #ff9fbf, #ec4d7d) !important; box-shadow: 0 12rpx 26rpx rgba(236, 77, 125, 0.28), inset 0 2rpx 0 rgba(255,255,255,0.4) !important; }
.i-teal { background: linear-gradient(150deg, #76e3d6, #13a3a0) !important; box-shadow: 0 12rpx 26rpx rgba(19, 163, 160, 0.28), inset 0 2rpx 0 rgba(255,255,255,0.4) !important; }
.mini-icon { width: 64rpx; height: 64rpx; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-right: 20rpx; background: linear-gradient(150deg, #5ad493, #1d9e6c); }
.mini-icon image { width: 36rpx; height: 36rpx; }

/* ---------------------------------------------------------------- round check (Reminders style) */
.check { width: 44rpx; height: 44rpx; border-radius: 50%; border: 3rpx solid rgba(60, 60, 67, 0.28); box-sizing: border-box; flex-shrink: 0; margin-right: 22rpx; display: flex; align-items: center; justify-content: center; }
.check.on { border: none; background: var(--accent-grad); }
.check.on::after { content: ""; width: 10rpx; height: 18rpx; border: solid #fff; border-width: 0 4rpx 4rpx 0; transform: rotate(45deg) translate(-1rpx, -2rpx); }

/* ---------------------------------------------------------------- segmented control */
.tabs { display: flex; padding: 6rpx; margin-bottom: 28rpx; border-radius: 22rpx; background: rgba(120, 128, 122, 0.14); }
.tabs .tab { flex: 1; text-align: center; padding: 14rpx 0; border-radius: 18rpx; font-size: 26rpx; color: var(--text-2); font-weight: 500; }
.tabs .tab.active { background: #fff; color: var(--text); font-weight: 600; box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.08), 0 1rpx 2rpx rgba(0, 0, 0, 0.06); }

/* ---------------------------------------------------------------- misc */
.empty { text-align: center; color: var(--text-3); padding: 48rpx 0; font-size: 26rpx; }
.notice { font-size: 22rpx; color: var(--text-3); line-height: 1.7; padding: 8rpx 12rpx 24rpx; }
.est { color: var(--orange); font-size: 22rpx; }
.pulse { animation: pulse 1.4s ease-in-out infinite; }
@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }

/* bottom sheet */
.mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 100; display: flex; align-items: flex-end; background: rgba(0, 0, 0, 0.22); }
.sheet {
  width: 100%; box-sizing: border-box; padding: 20rpx 40rpx calc(env(safe-area-inset-bottom) + 40rpx);
  border-radius: 44rpx 44rpx 0 0; background: rgba(250, 251, 249, 0.86);
  -webkit-backdrop-filter: saturate(180%) blur(30px); backdrop-filter: saturate(180%) blur(30px);
  box-shadow: 0 -10rpx 40rpx rgba(0, 0, 0, 0.10);
}
.sheet::before { content: ""; display: block; width: 72rpx; height: 10rpx; border-radius: 10rpx; background: rgba(60, 60, 67, 0.22); margin: 0 auto 28rpx; }
