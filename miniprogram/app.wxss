/* ==========================================================================
   MealAgent · 像素厨房 Pixel Kitchen design system
   - 1 art pixel = 4rpx (--px). Everything snaps to that grid.
   - Notched pixel outlines are drawn with four box-shadows (no border-radius anywhere).
   - Hard offset drop shadows, bevel highlights, stepped (steps()) animations only.
   - Fonts: "Pixel" (Fusion Pixel 12px, Chinese) and "PixelNum" (Press Start 2P, digits)
     are loaded at launch from the backend by app.js; system fonts are the fallback.
   Spec: docs/PIXEL_STYLE.md
   ========================================================================== */
page {
  --px: 4rpx;
  --ink: #2b2340;
  --ink-2: #4a3f6b;
  --paper: #fffaf0;
  --paper-2: #f3e9d2;
  --paper-3: #e2d3b1;
  --bg: #f4ecd8;
  --green: #4cb963;
  --green-d: #2e7d46;
  --green-l: #a6e88a;
  --red: #e8553e;
  --red-d: #a8322a;
  --red-l: #ffb3a1;
  --orange: #f59a2c;
  --orange-d: #b8641b;
  --yellow: #f8d24b;
  --yellow-d: #c79a1e;
  --blue: #4fa8e0;
  --blue-d: #2d6fa8;
  --blue-l: #b5e1ff;
  --purple: #8e6ad8;
  --purple-d: #5b3fa0;
  --pink: #f27ba6;
  --text: #2b2340;
  --text-2: #5e5470;
  --text-3: #958aa6;
  --shadow: rgba(43, 35, 64, 0.2);
  font-family: "Pixel", "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--text);
  background-color: var(--bg);
  /* graph-paper grid, 8 art pixels */
  background-image:
    linear-gradient(rgba(43, 35, 64, 0.045) 2rpx, transparent 2rpx),
    linear-gradient(90deg, rgba(43, 35, 64, 0.045) 2rpx, transparent 2rpx);
  background-size: 32rpx 32rpx;
}

.container { padding: 8rpx 36rpx; padding-bottom: calc(env(safe-area-inset-bottom) + 220rpx); }
.container.no-tab { padding-bottom: calc(env(safe-area-inset-bottom) + 80rpx); } /* secondary pages: no tab bar to clear */

/* ------------------------------------------------------------------ pixel window (card) */
.card {
  position: relative;
  background: var(--paper);
  margin: 4rpx 4rpx 36rpx;
  padding: 28rpx;
  box-shadow:
    0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink),
    inset -4rpx -4rpx 0 0 var(--paper-3), inset 4rpx 4rpx 0 0 #ffffff,
    8rpx 12rpx 0 0 var(--shadow);
}
.card.flush { padding: 8rpx 28rpx; }
.card.hero { background: #fffdf6; }
/* coloured window: green panel with white text (RPG status screen) */
.card.feature {
  background: var(--green);
  color: #fff;
  box-shadow:
    0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink),
    inset -4rpx -4rpx 0 0 var(--green-d), inset 4rpx 4rpx 0 0 var(--green-l),
    8rpx 12rpx 0 0 var(--shadow);
  text-shadow: 2rpx 2rpx 0 var(--green-d);
}
.card.feature .muted, .card.feature .lbl, .card.feature .small { color: #eafbe6; }
.card.feature.blue { background: var(--blue); box-shadow: 0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink), inset -4rpx -4rpx 0 0 var(--blue-d), inset 4rpx 4rpx 0 0 var(--blue-l), 8rpx 12rpx 0 0 var(--shadow); text-shadow: 2rpx 2rpx 0 var(--blue-d); }
.card.feature.orange { background: var(--orange); box-shadow: 0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink), inset -4rpx -4rpx 0 0 var(--orange-d), inset 4rpx 4rpx 0 0 #ffd08a, 8rpx 12rpx 0 0 var(--shadow); text-shadow: 2rpx 2rpx 0 var(--orange-d); }
.card.feature.purple { background: var(--purple); box-shadow: 0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink), inset -4rpx -4rpx 0 0 var(--purple-d), inset 4rpx 4rpx 0 0 #c5b0f5, 8rpx 12rpx 0 0 var(--shadow); text-shadow: 2rpx 2rpx 0 var(--purple-d); }
/* red window: failed / over budget / errors */
.card.feature.red { background: var(--red); box-shadow: 0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink), inset -4rpx -4rpx 0 0 var(--red-d), inset 4rpx 4rpx 0 0 var(--red-l), 8rpx 12rpx 0 0 var(--shadow); text-shadow: 2rpx 2rpx 0 var(--red-d); }
.card.feature.red .muted, .card.feature.red .lbl, .card.feature.red .small { color: #ffe9e3; }
/* dark RPG dialogue box */
.px-dialog {
  position: relative; background: var(--ink); color: #fffaf0; padding: 24rpx 28rpx; margin: 4rpx 4rpx 32rpx;
  box-shadow:
    0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink),
    inset 0 0 0 4rpx #fffaf0, inset 0 0 0 8rpx var(--ink), 8rpx 12rpx 0 0 var(--shadow);
}
/* yellow name tab on a window's top edge (the parent must be position: relative — .card and .px-dialog are).
   <view class="win-tab"><image class="win-tab-icon" src="/assets/px/flame.svg" />今日能量</view>
   Give the window ~40rpx top padding and ≥36rpx top margin so the tab clears what is above it.
   .name-plate is the same plate for a speaker's name on a .px-dialog (text only; .green / .purple tints). */
.win-tab, .name-plate {
  position: absolute; top: -20rpx; z-index: 2; display: flex; align-items: center; height: 40rpx;
  font-size: 24rpx; line-height: 40rpx; letter-spacing: 1rpx; white-space: nowrap; color: var(--ink); text-shadow: none; background: var(--yellow);
  box-shadow: 0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink),
    inset -4rpx -4rpx 0 0 var(--yellow-d), inset 4rpx 4rpx 0 0 #fff4b8;
}
.win-tab { left: 24rpx; padding: 0 16rpx 0 8rpx; }
.win-tab-icon { width: 32rpx; height: 32rpx; flex-shrink: 0; margin-right: 8rpx; }
.name-plate { left: 28rpx; padding: 0 16rpx; }
.name-plate.green { background: var(--green-l); box-shadow: 0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink), inset -4rpx -4rpx 0 0 var(--green), inset 4rpx 4rpx 0 0 #eafbe6; }
.name-plate.purple { background: #ddd0ff; box-shadow: 0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink), inset -4rpx -4rpx 0 0 var(--purple), inset 4rpx 4rpx 0 0 #ffffff; }

.card-title {
  display: flex; justify-content: space-between; align-items: center;
  font-size: 32rpx; margin-bottom: 18rpx; letter-spacing: 1rpx;
}
/* section header: ▶ + title on the grid paper */
.section-title {
  display: flex; justify-content: space-between; align-items: center;
  padding: 8rpx 4rpx 20rpx; font-size: 32rpx; letter-spacing: 1rpx;
}
.section-title::before { content: ""; width: 12rpx; height: 20rpx; margin-right: 14rpx; background: var(--ink); flex-shrink: 0;
  clip-path: polygon(0 0, 100% 50%, 0 100%); }
.section-title > :first-child { flex: 1; }
.section-title .link { font-size: 24rpx; color: var(--green-d); }
.section-title .sec-hint { font-size: 24rpx; color: var(--text-3); } /* muted right-side note that is not tappable */
.large-title { font-size: 48rpx; letter-spacing: 2rpx; }

/* ------------------------------------------------------------------ helpers */
.row { display: flex; align-items: center; }
.between { display: flex; justify-content: space-between; align-items: center; }
.wrap { flex-wrap: wrap; }
.grow { flex: 1; min-width: 0; }
.muted { color: var(--text-3); font-size: 24rpx; }
.small { font-size: 24rpx; color: var(--text-2); }
.bold { color: var(--text); letter-spacing: 1rpx; }
.card.feature .bold { color: #fff; }
.mt { margin-top: 16rpx; }
.mb { margin-bottom: 16rpx; }
.ml { margin-left: 12rpx; }
.center { text-align: center; }
.ellipsis { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.px-num, .num { font-family: "PixelNum", "Pixel", monospace; letter-spacing: 0; }
/* PixelNum glyphs sit high in their em box: nudge 20–24rpx digits down onto the Chinese baseline */
.px-num.inline { position: relative; top: 4rpx; line-height: 1; }

/* ------------------------------------------------------------------ tags & chips */
.tag {
  display: inline-block; padding: 2rpx 14rpx; margin: 6rpx 14rpx 6rpx 4rpx; font-size: 24rpx; line-height: 1.6;
  background: var(--green-l); color: var(--green-d);
  box-shadow: 0 -2rpx 0 0 var(--green-d), 0 2rpx 0 0 var(--green-d), -2rpx 0 0 0 var(--green-d), 2rpx 0 0 0 var(--green-d);
}
.tag.warn { background: #ffe2b0; color: var(--orange-d); box-shadow: 0 -2rpx 0 0 var(--orange-d), 0 2rpx 0 0 var(--orange-d), -2rpx 0 0 0 var(--orange-d), 2rpx 0 0 0 var(--orange-d); }
.tag.danger { background: var(--red-l); color: var(--red-d); box-shadow: 0 -2rpx 0 0 var(--red-d), 0 2rpx 0 0 var(--red-d), -2rpx 0 0 0 var(--red-d), 2rpx 0 0 0 var(--red-d); }
.tag.gray { background: var(--paper-2); color: var(--text-2); box-shadow: 0 -2rpx 0 0 var(--paper-3), 0 2rpx 0 0 var(--paper-3), -2rpx 0 0 0 var(--paper-3), 2rpx 0 0 0 var(--paper-3); }
.tag.glass { background: rgba(255, 255, 255, 0.25); color: #fff; box-shadow: 0 -2rpx 0 0 #fff, 0 2rpx 0 0 #fff, -2rpx 0 0 0 #fff, 2rpx 0 0 0 #fff; text-shadow: none; }
.tag.blue { background: var(--blue-l); color: var(--blue-d); box-shadow: 0 -2rpx 0 0 var(--blue-d), 0 2rpx 0 0 var(--blue-d), -2rpx 0 0 0 var(--blue-d), 2rpx 0 0 0 var(--blue-d); }
.tag.gold { background: var(--yellow); color: var(--ink); box-shadow: 0 -2rpx 0 0 var(--yellow-d), 0 2rpx 0 0 var(--yellow-d), -2rpx 0 0 0 var(--yellow-d), 2rpx 0 0 0 var(--yellow-d); }
.tag.purple { background: #ddd0ff; color: var(--purple-d); box-shadow: 0 -2rpx 0 0 var(--purple-d), 0 2rpx 0 0 var(--purple-d), -2rpx 0 0 0 var(--purple-d), 2rpx 0 0 0 var(--purple-d); }
/* small orange "估算" badge after an estimated value */
.est-badge {
  display: inline-block; flex-shrink: 0; margin: 2rpx 0 2rpx 12rpx; padding: 0 8rpx; font-size: 20rpx; line-height: 32rpx; white-space: nowrap;
  color: var(--orange-d); background: #ffe2b0; text-shadow: none;
  box-shadow: 0 -2rpx 0 0 var(--orange-d), 0 2rpx 0 0 var(--orange-d), -2rpx 0 0 0 var(--orange-d), 2rpx 0 0 0 var(--orange-d);
}

.chips { white-space: nowrap; margin: 0 -36rpx 28rpx; padding: 8rpx 40rpx 16rpx; box-sizing: border-box; width: auto; }
.chip {
  display: inline-flex; align-items: center; vertical-align: top; margin-right: 24rpx; padding: 14rpx 22rpx;
  background: var(--paper);
  box-shadow: 0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink), 6rpx 8rpx 0 0 var(--shadow);
}
.chip .dot { width: 12rpx; height: 12rpx; background: var(--green); margin-right: 14rpx; box-shadow: 0 0 0 2rpx var(--ink); }
.chip .dot.warn { background: var(--orange); }
.chip .dot.danger { background: var(--red); }
.chip-main { font-size: 28rpx; }
.chip-sub { font-size: 24rpx; color: var(--text-3); margin-left: 10rpx; }

/* ------------------------------------------------------------------ buttons
   Add hover-class="px-pressed" in WXML for the press-down effect. */
.btn {
  position: relative; display: block; text-align: center;
  padding: 22rpx 32rpx; margin: 4rpx; font-size: 32rpx; letter-spacing: 2rpx; line-height: 1.4;
  background: var(--green); color: #fff; text-shadow: 2rpx 2rpx 0 var(--green-d);
  box-shadow:
    0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink),
    inset -4rpx -6rpx 0 0 var(--green-d), inset 4rpx 4rpx 0 0 var(--green-l),
    6rpx 8rpx 0 0 var(--shadow);
}
.btn.ghost, .btn.tinted, .btn.light {
  background: var(--paper); color: var(--text); text-shadow: none;
  box-shadow:
    0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink),
    inset -4rpx -6rpx 0 0 var(--paper-3), inset 4rpx 4rpx 0 0 #fff, 6rpx 8rpx 0 0 var(--shadow);
}
.btn.warn {
  background: var(--orange); text-shadow: 2rpx 2rpx 0 var(--orange-d);
  box-shadow:
    0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink),
    inset -4rpx -6rpx 0 0 var(--orange-d), inset 4rpx 4rpx 0 0 #ffd08a, 6rpx 8rpx 0 0 var(--shadow);
}
.btn.danger {
  background: var(--red); text-shadow: 2rpx 2rpx 0 var(--red-d);
  box-shadow:
    0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink),
    inset -4rpx -6rpx 0 0 var(--red-d), inset 4rpx 4rpx 0 0 var(--red-l), 6rpx 8rpx 0 0 var(--shadow);
}
.btn.small { padding: 10rpx 22rpx; font-size: 24rpx; }
.btn[disabled] { opacity: 0.5; }
button.btn { line-height: 1.4; border-radius: 0; }
button.btn::after { border: none; }
.btn-row { display: flex; gap: 24rpx; margin-top: 24rpx; }
.btn-row .btn { flex: 1; }
.btn-icon { width: 32rpx; height: 32rpx; vertical-align: -6rpx; margin-right: 12rpx; } /* 16px art at 1:1 */
/* pressed: sink into the shadow */
.px-pressed { transform: translate(4rpx, 6rpx); box-shadow: 0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink) !important; }
/* pressed list row inside a window: paper-2 tint + top inner shade, no ink outline, no movement */
.px-pressed-row { background-color: var(--paper-2); box-shadow: inset 0 4rpx 0 0 var(--paper-3); }

/* ------------------------------------------------------------------ inputs (inset, old-school) */
.input {
  background: #ffffff; padding: 16rpx 22rpx; font-size: 28rpx; min-height: 44rpx;
  box-shadow: 0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink),
    inset 4rpx 4rpx 0 0 var(--paper-3);
  margin: 4rpx;
}
.textarea {
  background: #ffffff; padding: 22rpx 24rpx; width: auto; min-height: 180rpx; font-size: 28rpx; line-height: 1.7;
  box-shadow: 0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink),
    inset 4rpx 4rpx 0 0 var(--paper-3);
  margin: 4rpx;
}
.field { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 4rpx dashed var(--paper-3); min-height: 48rpx; }
.field:last-child { border-bottom: none; }
.field .label { width: 190rpx; color: var(--text); font-size: 28rpx; }
.field .input { flex: 1; }
/* inside a list window: flat right-aligned value */
.card.flush .field .input { background: transparent; box-shadow: none; text-align: right; padding: 0; margin: 0; color: var(--text-2); }
.chat-bar { display: flex; gap: 16rpx; align-items: center; }
.chat-bar .input { flex: 1; }
.send {
  width: 80rpx; height: 80rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin: 4rpx;
  background: var(--green);
  box-shadow: 0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink),
    inset -4rpx -4rpx 0 0 var(--green-d), inset 4rpx 4rpx 0 0 var(--green-l);
}
.send image { width: 48rpx; height: 48rpx; }

/* ------------------------------------------------------------------ lists */
.list-item { padding: 22rpx 0; border-bottom: 4rpx dashed var(--paper-3); }
.list-item:last-child { border-bottom: none; }
.chevron { color: var(--text-3); font-size: 28rpx; margin-left: 12rpx; }
.avatar {
  width: 80rpx; height: 80rpx; flex-shrink: 0; margin: 4rpx 24rpx 4rpx 4rpx;
  display: flex; align-items: center; justify-content: center; font-size: 32rpx; color: #fff;
  background: var(--green); text-shadow: 2rpx 2rpx 0 rgba(43, 35, 64, 0.4);
  box-shadow: 0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink),
    inset -4rpx -4rpx 0 0 rgba(43, 35, 64, 0.25), inset 4rpx 4rpx 0 0 rgba(255, 255, 255, 0.45);
}
.avatar.round { }

/* ------------------------------------------------------------------ stats & pixel bars */
.stat { flex: 1; text-align: center; }
.stat .num { font-size: 32rpx; line-height: 1.5; color: var(--green-d); }
.card.feature .stat .num { color: #fff; }
.stat .lbl { font-size: 24rpx; color: var(--text-3); margin-top: 6rpx; }
/* segmented pixel bar (HP bar). Prefer the <px-meter> component for animated meters. */
.bar {
  height: 20rpx; background: #fff; overflow: hidden; margin: 4rpx;
  box-shadow: 0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink);
}
.bar.thin { height: 12rpx; }
.bar .fill {
  height: 100%;
  background-color: var(--green);
  background-image: repeating-linear-gradient(90deg, transparent 0, transparent 20rpx, rgba(43, 35, 64, 0.25) 20rpx, rgba(43, 35, 64, 0.25) 24rpx);
  box-shadow: inset 0 4rpx 0 0 rgba(255, 255, 255, 0.45);
}
.bar .fill.warn { background-color: var(--orange); }
.bar .fill.danger { background-color: var(--red); }
.bar .fill.blue { background-color: var(--blue); }
.bar .fill.indigo { background-color: var(--purple); }

/* ------------------------------------------------------------------ icon tiles */
.grid { display: flex; flex-wrap: wrap; }
.grid-item { width: 33.33%; text-align: center; padding: 18rpx 0; font-size: 24rpx; color: var(--text); }
.grid-item .icon, .mini-icon {
  display: flex; align-items: center; justify-content: center; background: var(--green-l);
  box-shadow: 0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink),
    inset -4rpx -4rpx 0 0 rgba(43, 35, 64, 0.18), inset 4rpx 4rpx 0 0 rgba(255, 255, 255, 0.6), 6rpx 8rpx 0 0 var(--shadow);
}
.grid-item .icon { width: 104rpx; height: 104rpx; margin: 4rpx auto 16rpx; }
.grid-item .icon image { width: 64rpx; height: 64rpx; }
.mini-icon { width: 64rpx; height: 64rpx; flex-shrink: 0; margin: 4rpx 22rpx 4rpx 4rpx; }
.mini-icon image { width: 48rpx; height: 48rpx; }
.i-blue { background: var(--blue-l) !important; }
.i-orange { background: #ffe2b0 !important; }
.i-purple { background: #ddd0ff !important; }
.i-pink { background: #ffd0e0 !important; }
.i-teal { background: #c8f2e6 !important; }
.i-yellow { background: #fff1b0 !important; }
.i-red { background: var(--red-l) !important; }

/* ------------------------------------------------------------------ colour utilities
   Agent cells (light fills behind the four agent sprites). Key = agent key from the backend. */
.agent-health { background-color: var(--green-l); }
.agent-iterative { background-color: #ddd0ff; }
.agent-inventory { background-color: var(--blue-l); }
.agent-budget { background-color: #ffd0e0; }
/* Food categories (inventory / shopping / budget / recognize): class="cat-{{item.category}}".
   Solid fills; staples and other carry ink text. !important so they win over page-level fills and text colours. */
.cat-vegetables { background-color: var(--green) !important; }
.cat-meat_eggs { background-color: var(--red) !important; }
.cat-seafood { background-color: var(--blue) !important; }
.cat-staples { background-color: var(--yellow) !important; color: var(--ink) !important; text-shadow: none !important; }
.cat-soy_dairy { background-color: var(--purple) !important; }
.cat-seasonings { background-color: #a89fb8 !important; }
.cat-other { background-color: #c9c3d6 !important; color: var(--ink) !important; text-shadow: none !important; }
/* Rotating member tones for avatars / roster tiles (white text). */
.tone-green { background-color: var(--green) !important; }
.tone-blue { background-color: var(--blue) !important; }
.tone-orange { background-color: var(--orange) !important; }
.tone-purple { background-color: var(--purple) !important; }
.tone-pink { background-color: var(--pink) !important; }

/* ------------------------------------------------------------------ pixel checkbox */
.check {
  width: 36rpx; height: 36rpx; flex-shrink: 0; margin: 4rpx 24rpx 4rpx 4rpx; position: relative; background: #fff;
  box-shadow: 0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink), inset 4rpx 4rpx 0 0 var(--paper-3);
}
.check.on { background: var(--green); box-shadow: 0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink), inset -4rpx -4rpx 0 0 var(--green-d); }
/* pixel tick: two blocks drawn with box-shadow */
.check.on::after {
  content: ""; position: absolute; left: 4rpx; top: 16rpx; width: 4rpx; height: 4rpx; background: #fff;
  box-shadow: 4rpx 4rpx 0 0 #fff, 8rpx 8rpx 0 0 #fff, 12rpx 4rpx 0 0 #fff, 16rpx 0 0 0 #fff, 20rpx -4rpx 0 0 #fff, 24rpx -8rpx 0 0 #fff;
}

/* ------------------------------------------------------------------ pixel ON / OFF switch (native <switch> stays round)
   <view class="px-toggle {{on ? 'on' : ''}}" bindtap="…" hover-class="px-pressed">
     <view class="px-toggle-knob"></view><text class="px-num px-toggle-txt">{{on ? 'ON' : 'OFF'}}</text>
   </view> */
.px-toggle {
  position: relative; width: 136rpx; height: 48rpx; flex-shrink: 0; margin: 4rpx; background: var(--paper-3);
  box-shadow: 0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink), inset 4rpx 4rpx 0 0 rgba(43, 35, 64, 0.18);
}
.px-toggle.on { background: var(--green); box-shadow: 0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink), inset 4rpx 4rpx 0 0 var(--green-d); }
.px-toggle-knob {
  position: absolute; top: 4rpx; left: 4rpx; width: 40rpx; height: 40rpx; background: var(--paper); transition: left 0.12s steps(2);
  box-shadow: inset -4rpx -4rpx 0 0 var(--paper-3), inset 4rpx 4rpx 0 0 #ffffff, 4rpx 0 0 0 var(--ink);
}
.px-toggle.on .px-toggle-knob { left: 92rpx; box-shadow: inset -4rpx -4rpx 0 0 var(--paper-3), inset 4rpx 4rpx 0 0 #ffffff, -4rpx 0 0 0 var(--ink); }
.px-toggle-txt { position: absolute; top: 0; left: 48rpx; right: 0; text-align: center; font-size: 20rpx; line-height: 48rpx; color: var(--text-2); }
.px-toggle.on .px-toggle-txt { left: 0; right: 48rpx; color: #ffffff; text-shadow: 2rpx 2rpx 0 var(--green-d); }

/* ------------------------------------------------------------------ pixel tabs */
.tabs { display: flex; margin: 8rpx 4rpx 32rpx; gap: 12rpx; }
.tabs .tab {
  flex: 1; text-align: center; padding: 14rpx 0; font-size: 24rpx; color: var(--text-2); background: var(--paper-2);
  box-shadow: 0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink), inset -4rpx -4rpx 0 0 var(--paper-3);
}
.tabs .tab.active {
  background: var(--yellow); color: var(--ink); transform: translateY(-6rpx);
  box-shadow: 0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink),
    inset -4rpx -4rpx 0 0 var(--yellow-d), inset 4rpx 4rpx 0 0 #fff4b8, 4rpx 10rpx 0 0 var(--shadow);
}

/* ------------------------------------------------------------------ misc */
.empty { text-align: center; color: var(--text-3); padding: 40rpx 0; font-size: 24rpx; }
.notice { font-size: 24rpx; color: var(--text-3); line-height: 1.8; padding: 0 8rpx 28rpx; }
.est { color: var(--orange-d); font-size: 24rpx; }
/* calendar date plate: red band (month or weekday) over a big pixel day number; .sm for compact rows
   <view class="px-cal"><view class="px-cal-top">10月</view><view class="px-num px-cal-day">14</view></view> */
.px-cal {
  width: 88rpx; flex-shrink: 0; margin: 4rpx 24rpx 4rpx 4rpx; text-align: center; background: #ffffff;
  box-shadow: 0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink), inset 0 -4rpx 0 0 var(--paper-3);
}
.px-cal-top { font-size: 20rpx; line-height: 36rpx; white-space: nowrap; color: #ffffff; background: var(--red); box-shadow: inset 0 -4rpx 0 0 var(--red-d); text-shadow: 2rpx 2rpx 0 var(--red-d); }
.px-cal-day { font-family: "PixelNum", "Pixel", monospace; font-size: 32rpx; line-height: 64rpx; color: var(--ink); text-shadow: none; }
.px-cal.sm { width: 72rpx; margin-right: 20rpx; }
.px-cal.sm .px-cal-top { line-height: 32rpx; }
.px-cal.sm .px-cal-day { font-size: 24rpx; line-height: 48rpx; }
/* status light: the ink frame stays put, only the core lights / blinks (put .anim-blink on the core, not the frame)
   <view class="px-led on"><view class="px-led-core anim-blink"></view></view>   .on = green, .red = red, none = off (grey); .sm = 12rpx */
.px-led { width: 16rpx; height: 16rpx; flex-shrink: 0; margin: 4rpx; background: var(--ink-2); box-shadow: 0 0 0 4rpx var(--ink); }
.px-led.sm { width: 12rpx; height: 12rpx; }
.px-led-core { width: 100%; height: 100%; background: var(--text-3); }
.px-led.on .px-led-core { background: var(--green-l); }
.px-led.red .px-led-core { background: var(--red); box-shadow: inset 4rpx 4rpx 0 0 var(--red-l); }
.mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 100; display: flex; align-items: flex-end;
  background-color: rgba(43, 35, 64, 0.45);
  background-image: repeating-linear-gradient(0deg, rgba(43, 35, 64, 0.12) 0, rgba(43, 35, 64, 0.12) 4rpx, transparent 4rpx, transparent 8rpx); }
.sheet {
  width: 100%; box-sizing: border-box; padding: 32rpx 40rpx calc(env(safe-area-inset-bottom) + 40rpx);
  background: var(--paper); animation: px-slide-up 0.24s steps(4) both;
  box-shadow: 0 -8rpx 0 0 var(--ink), inset 0 4rpx 0 0 #fff, inset 0 -4rpx 0 0 var(--paper-3);
}
/* square close key for a sheet header: <view class="sheet-close" bindtap="…" hover-class="px-pressed"><image src="/assets/px/cross.svg" /></view> */
.sheet-close {
  width: 56rpx; height: 56rpx; margin: 4rpx; display: flex; align-items: center; justify-content: center; background: var(--paper);
  box-shadow: 0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink),
    inset -4rpx -4rpx 0 0 var(--paper-3), 4rpx 6rpx 0 0 var(--shadow);
}
.sheet-close image { width: 32rpx; height: 32rpx; }

/* ==================================================================
   Animation library — stepped motion only (see docs/PIXEL_STYLE.md)
   ================================================================== */
@keyframes px-bob { 0%, 49% { transform: translateY(0); } 50%, 100% { transform: translateY(-6rpx); } }
@keyframes px-blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
@keyframes px-pop-in {
  0% { transform: scale(0.4); opacity: 0; }
  50% { transform: scale(1.12); opacity: 1; }
  75% { transform: scale(0.94); }
  100% { transform: scale(1); opacity: 1; }
}
@keyframes px-slide-up { from { transform: translateY(40rpx); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
@keyframes px-slide-in { from { transform: translateX(-32rpx); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
@keyframes px-shake { 0%, 100% { transform: translateX(0); } 25% { transform: translateX(-6rpx); } 75% { transform: translateX(6rpx); } }
@keyframes px-coin { 0% { transform: scaleX(1); } 25% { transform: scaleX(0.5); } 50% { transform: scaleX(0.1); } 75% { transform: scaleX(0.5); } 100% { transform: scaleX(1); } }
@keyframes px-march { from { background-position: 0 0; } to { background-position: 48rpx 0; } }
@keyframes px-float-up { 0% { transform: translateY(0); opacity: 1; } 100% { transform: translateY(-48rpx); opacity: 0; } }
@keyframes px-wiggle { 0%, 100% { transform: rotate(0); } 25% { transform: rotate(-8deg); } 75% { transform: rotate(8deg); } }
@keyframes px-glow { 0%, 49% { box-shadow: 0 0 0 4rpx var(--yellow); } 50%, 100% { box-shadow: 0 0 0 4rpx transparent; } }

.anim-bob { animation: px-bob 0.8s linear infinite; }
.anim-blink { animation: px-blink 1s linear infinite; }
.anim-pop { animation: px-pop-in 0.36s steps(4) both; }
.anim-slide { animation: px-slide-up 0.3s steps(4) both; }
.anim-slide-x { animation: px-slide-in 0.3s steps(4) both; }
.anim-shake { animation: px-shake 0.3s steps(4) 2; }
.anim-coin { animation: px-coin 0.9s steps(4) infinite; }
.anim-wiggle { animation: px-wiggle 0.6s steps(4) infinite; }
.anim-float { animation: px-float-up 0.8s steps(6) forwards; }
/* stagger helpers for lists: class="anim-slide d1" … */
.d1 { animation-delay: 0.06s; } .d2 { animation-delay: 0.12s; } .d3 { animation-delay: 0.18s; }
.d4 { animation-delay: 0.24s; } .d5 { animation-delay: 0.3s; } .d6 { animation-delay: 0.36s; }
/* marching "loading" stripes */
.px-loading {
  height: 24rpx; margin: 4rpx;
  background-color: var(--green);
  background-image: repeating-linear-gradient(90deg, var(--green) 0, var(--green) 24rpx, var(--green-l) 24rpx, var(--green-l) 48rpx);
  animation: px-march 0.6s steps(4) infinite;
  box-shadow: 0 -4rpx 0 0 var(--ink), 0 4rpx 0 0 var(--ink), -4rpx 0 0 0 var(--ink), 4rpx 0 0 0 var(--ink);
}
.pulse { animation: px-blink 1.2s linear infinite; }
