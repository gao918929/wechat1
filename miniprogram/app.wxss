page {
  background: #f6f7f2;
  color: #19372a;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}
.page {
  padding: 32rpx 30rpx 70rpx;
}
.hero {
  background: #164d35;
  color: #fff;
  border-radius: 28rpx;
  padding: 38rpx 32rpx;
  margin-bottom: 26rpx;
}
.eyebrow {
  font-size: 21rpx;
  letter-spacing: 4rpx;
  opacity: 0.72;
  margin-bottom: 12rpx;
}
.title {
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.4;
}
.subtitle {
  font-size: 25rpx;
  opacity: 0.8;
  margin-top: 12rpx;
  line-height: 1.7;
}
.card {
  background: #fff;
  border: 1rpx solid #e3e9df;
  border-radius: 22rpx;
  padding: 28rpx;
  margin: 18rpx 0;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.grow {
  flex: 1;
  min-width: 0;
}
.heading {
  font-weight: 650;
  font-size: 32rpx;
  margin: 24rpx 0 12rpx;
}
.muted {
  color: #758478;
  font-size: 24rpx;
  line-height: 1.6;
}
.small {
  font-size: 24rpx;
}
.label {
  font-size: 24rpx;
  color: #647765;
  margin: 22rpx 0 10rpx;
}
.field,
input,
picker {
  background: #f4f7f0;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  min-height: 78rpx;
}
textarea {
  background: #f4f7f0;
  border-radius: 14rpx;
  padding: 20rpx;
  width: 100%;
  box-sizing: border-box;
  min-height: 190rpx;
}
.button,
button {
  border-radius: 14rpx;
  font-size: 27rpx;
  font-weight: 600;
  margin-top: 18rpx;
  background: #205c3d;
  color: #fff;
  line-height: 2.8;
}
button::after {
  border: none;
}
button.secondary {
  background: #eaf1e2;
  color: #285537;
}
button.danger {
  background: #fcf0e8;
  color: #ab4e2f;
}
button.mini {
  display: inline-block;
  width: auto;
  min-width: 110rpx;
  margin: 4rpx 0;
  font-size: 23rpx;
  line-height: 2.4;
  padding: 0 18rpx;
}
.badge {
  display: inline-block;
  font-size: 20rpx;
  padding: 7rpx 13rpx;
  border-radius: 8rpx;
  background: #eaf1e2;
  color: #42683d;
}
.warn {
  background: #fff0d9;
  color: #976716;
}
.error {
  background: #fff0ec;
  color: #a84229;
}
.empty {
  padding: 50rpx 24rpx;
  text-align: center;
  color: #7c8a7c;
  line-height: 1.8;
}
.divider {
  height: 1rpx;
  background: #edf0e9;
  margin: 24rpx 0;
}
.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.metric {
  flex: 1;
  min-width: 160rpx;
  background: #fff;
  border: 1rpx solid #e3e9df;
  border-radius: 20rpx;
  padding: 26rpx;
}
.metric .number {
  font-size: 46rpx;
  font-weight: 700;
}
.navtabs {
  display: flex;
  gap: 12rpx;
  margin: 20rpx 0;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 6rpx;
  border-radius: 12rpx;
  background: #e7eddc;
  font-size: 24rpx;
}
.tab.active {
  background: #205c3d;
  color: white;
}
.notice {
  font-size: 22rpx;
  color: #7b846e;
  line-height: 1.7;
  padding: 18rpx 0;
}
.choice {
  display: inline-flex;
  align-items: center;
  font-size: 25rpx;
  padding: 12rpx 4rpx;
  margin-right: 12rpx;
}
.chartbar {
  height: 12rpx;
  background: #9ec478;
  border-radius: 6rpx;
  margin: 10rpx 0 20rpx;
}
.steps {
  font-size: 25rpx;
  line-height: 1.8;
  color: #536753;
}
.nowrap {
  white-space: nowrap;
}
.copycanvas {
  position: fixed;
  left: -2000px;
  top: -2000px;
  width: 360px;
}
.link {
  color: #317445;
}
.mono {
  font-family: monospace;
  word-break: break-all;
}
