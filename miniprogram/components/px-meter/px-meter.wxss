.pxm {
  display: flex; gap: 4rpx; padding: 4rpx; margin: 4rpx; background: #2b2340;
  box-shadow: 0 0 0 4rpx #2b2340;
}
.pxm-cell { flex: 1; background: #4a3f6b; }
.pxm-on { box-shadow: inset 0 4rpx 0 0 rgba(255, 255, 255, 0.45), inset 0 -4rpx 0 0 rgba(43, 35, 64, 0.25); }
.pxm-green { background: #4cb963; }
.pxm-orange { background: #f59a2c; }
.pxm-red { background: #e8553e; }
.pxm-blue { background: #4fa8e0; }
.pxm-purple { background: #8e6ad8; }
.pxm-yellow { background: #f8d24b; }
.pxm-over .pxm-on { background: #e8553e; animation: pxm-flash 0.8s steps(2) infinite; }
.pxm-anim { animation: pxm-in 0.2s steps(2) both; }
@keyframes pxm-in { from { opacity: 0; transform: scaleY(0.3); } to { opacity: 1; transform: scaleY(1); } }
@keyframes pxm-flash { 0%, 49% { background: #e8553e; } 50%, 100% { background: #ffb3a1; } }
