# Copy to .env. No credentials are bundled or read from your Codex configuration.
MEALAGENT_DB=data/mealagent.sqlite3
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_VISION_MODEL=deepseek-flash
# Optional OpenAI-compatible OCR/vision fallback. Only used for recognition failures.
VISION_FALLBACK_BASE_URL=
VISION_FALLBACK_API_KEY=
VISION_FALLBACK_MODEL=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Disabled by default. Local development only; NEVER enable on a public deployment.
ALLOW_DEV_LOGIN=false
DEV_LOGIN_KEY=
SESSION_DAYS=7
LLM_TIMEOUT_SECONDS=180
# Explicit web-console CORS allowlist; native WeChat does not require CORS.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
