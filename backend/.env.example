# ---- DeepSeek (OpenAI-compatible API) ----
# Leave DEEPSEEK_API_KEY empty to run the rule-based offline engine (dev/tests only).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Text model used by the orchestrator and the four agents
DEEPSEEK_MODEL=deepseek-chat
# Multimodal model used for ingredient / receipt / meal photos.
# Point it at a vision-capable DeepSeek deployment (e.g. a DeepSeek-VL endpoint
# exposed through an OpenAI-compatible gateway); DEEPSEEK_VISION_BASE_URL/KEY
# default to the values above.
DEEPSEEK_VISION_MODEL=deepseek-chat
DEEPSEEK_VISION_BASE_URL=
DEEPSEEK_VISION_API_KEY=
LLM_TIMEOUT_SECONDS=120

# ---- WeChat mini program (leave empty for local dev login) ----
WECHAT_APPID=
WECHAT_SECRET=
# Subscription-message template used to notify "meal plan ready"
WECHAT_PLAN_TEMPLATE_ID=

# ---- Server ----
MEALAGENT_SECRET=change-me-to-a-long-random-string
MEALAGENT_DATABASE_URL=sqlite:///./data/mealagent.db
MEALAGENT_UPLOAD_DIR=./data/uploads
# Path to the LLM Wiki (defaults to ../llm_wiki)
MEALAGENT_WIKI_DIR=
# Default city for reference prices (informational)
MEALAGENT_CITY=北京
